{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repeated effect comparison without lifecycle authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "reason",
    "evidence_scope",
    "quality_evidence_eligible",
    "owner_review_required",
    "lifecycle_authority",
    "release_authorized",
    "raw_content_stored"
  ],
  "properties": {
    "schema_version": {
      "const": "adk-effect-trial-comparison/v1"
    },
    "verdict": {
      "enum": [
        "improved",
        "non-inferior",
        "regressed",
        "inconclusive",
        "invalid"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 256
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^ref:[0-9a-f]{64}$"
    },
    "input_ref": {
      "type": "string",
      "pattern": "^ref:[0-9a-f]{64}$"
    },
    "controls_ref": {
      "type": "string",
      "pattern": "^ref:[0-9a-f]{64}$"
    },
    "task_count": {
      "type": "integer",
      "minimum": 1
    },
    "trials_per_task": {
      "type": "integer",
      "minimum": 1
    },
    "run_count": {
      "type": "integer",
      "minimum": 2
    },
    "trial_comparisons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "comparison_ref",
          "infrastructure_status"
        ],
        "properties": {
          "trial_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "comparison_ref": {
            "type": "string",
            "pattern": "^ref:[0-9a-f]{64}$"
          },
          "infrastructure_status": {
            "enum": [
              "ok",
              "failed"
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task-success-rate",
        "first-pass-success-rate",
        "human-interventions-per-task",
        "latency-per-task-ms",
        "cost-per-task",
        "token-usage-per-task",
        "wrong-skill-rate",
        "abstain-rate"
      ],
      "properties": {
        "task-success-rate": {
          "oneOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "$ref": "#/$defs/not-comparable"
            }
          ]
        },
        "first-pass-success-rate": {
          "oneOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "$ref": "#/$defs/not-comparable"
            }
          ]
        },
        "human-interventions-per-task": {
          "oneOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "$ref": "#/$defs/not-comparable"
            }
          ]
        },
        "latency-per-task-ms": {
          "oneOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "$ref": "#/$defs/not-comparable"
            }
          ]
        },
        "cost-per-task": {
          "oneOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "$ref": "#/$defs/not-comparable"
            }
          ]
        },
        "token-usage-per-task": {
          "oneOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "$ref": "#/$defs/not-comparable"
            }
          ]
        },
        "wrong-skill-rate": {
          "oneOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "$ref": "#/$defs/not-comparable"
            }
          ]
        },
        "abstain-rate": {
          "oneOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "$ref": "#/$defs/not-comparable"
            }
          ]
        }
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "type": "object"
        },
        "candidate": {
          "type": "object"
        }
      }
    },
    "outcome_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "candidate": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "evidence_scope": {
      "const": "test-only"
    },
    "quality_evidence_eligible": {
      "const": false
    },
    "owner_review_required": {
      "const": true
    },
    "lifecycle_authority": {
      "const": "none-evidence-only"
    },
    "release_authorized": {
      "const": false
    },
    "raw_content_stored": {
      "const": false
    },
    "control_authority": {
      "const": "caller-declared-test-bindings-not-attested"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "not": {
              "const": "invalid"
            }
          }
        }
      },
      "then": {
        "required": [
          "schema_version",
          "verdict",
          "reason",
          "campaign_id",
          "plan_ref",
          "input_ref",
          "controls_ref",
          "task_count",
          "trials_per_task",
          "run_count",
          "trial_comparisons",
          "metrics",
          "reliability",
          "outcome_counts",
          "evidence_scope",
          "quality_evidence_eligible",
          "owner_review_required",
          "lifecycle_authority",
          "release_authorized",
          "raw_content_stored",
          "control_authority",
          "limitations"
        ]
      }
    }
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "task_count",
        "sampling_unit",
        "baseline",
        "candidate",
        "candidate_minus_baseline",
        "difference_interval",
        "benefit_interval",
        "confidence",
        "method",
        "direction",
        "unit"
      ],
      "properties": {
        "status": {
          "const": "measured"
        },
        "task_count": {
          "type": "integer",
          "minimum": 1
        },
        "sampling_unit": {
          "const": "task"
        },
        "baseline": {
          "type": "object"
        },
        "candidate": {
          "type": "object"
        },
        "candidate_minus_baseline": {
          "type": "number"
        },
        "difference_interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "benefit_interval": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "method": {
          "const": "paired-task-percentile-bootstrap-bonferroni"
        },
        "direction": {
          "enum": [
            "higher",
            "lower",
            "diagnostic"
          ]
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "not-comparable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "not-comparable"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}