{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-kit.local/schemas/native-target-conformance-receipt-v1.json",
  "title": "ADK native target conformance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "target",
    "runtime",
    "bundle_sha256",
    "contract_sha256",
    "verified_at",
    "stages"
  ],
  "properties": {
    "schema": {"const": "adk-native-target-conformance-receipt/v1"},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary", "binary_sha256", "version", "version_pin"],
      "properties": {
        "binary": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "version": {"$ref": "#/$defs/version"},
        "version_pin": {"$ref": "#/$defs/version"}
      }
    },
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "verified_at": {"type": "string", "format": "date-time"},
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stage"},
      "allOf": [
        {"contains": {"properties": {"stage": {"const": "discovery"}}, "required": ["stage"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"stage": {"const": "load"}}, "required": ["stage"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"stage": {"const": "trigger"}}, "required": ["stage"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]*$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "command_sha256",
        "result_sha256",
        "exit_code",
        "started_at",
        "completed_at",
        "duration_ms",
        "environment",
        "privacy",
        "authority"
      ],
      "properties": {
        "stage": {"enum": ["discovery", "load", "trigger"]},
        "command_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "exit_code": {"const": 0},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "architecture",
            "cwd_sha256",
            "environment_sha256",
            "runtime_binary_sha256",
            "bundle_sha256",
            "contract_sha256"
          ],
          "properties": {
            "platform": {"$ref": "#/$defs/identifier"},
            "architecture": {"$ref": "#/$defs/identifier"},
            "cwd_sha256": {"$ref": "#/$defs/sha256"},
            "environment_sha256": {"$ref": "#/$defs/sha256"},
            "runtime_binary_sha256": {"$ref": "#/$defs/sha256"},
            "bundle_sha256": {"$ref": "#/$defs/sha256"},
            "contract_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_content_stored", "secrets_stored", "sanitized"],
          "properties": {
            "raw_content_stored": {"const": false},
            "secrets_stored": {"const": false},
            "sanitized": {"const": true}
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution_authority", "authority_id", "scope", "attestation_sha256"],
          "properties": {
            "execution_authority": {"enum": ["human-approved", "ci-approved"]},
            "authority_id": {"$ref": "#/$defs/identifier"},
            "scope": {"enum": ["discovery", "load", "trigger"]},
            "attestation_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
