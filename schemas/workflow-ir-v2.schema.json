{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-kit.local/schemas/workflow-ir-v2.json",
  "type": "object",
  "required": ["schema_version", "policy_schema_version", "runtime_boundary", "workflow_count", "workflows"],
  "properties": {
    "schema_version": {"const": "adk-workflow-ir/v2"},
    "policy_schema_version": {"const": "adk-workflow-ir-policy/v1"},
    "runtime_boundary": {"type": "string", "minLength": 1},
    "workflow_count": {"type": "integer", "minimum": 1},
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workflow"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "node": {
      "type": "object",
      "required": [
        "node_id", "ordinal", "stage_class", "terminal", "terminal_state", "inputs", "outputs",
        "side_effect", "approval", "retry", "timeout", "cancellation", "idempotency", "checkpoint",
        "rollback", "required_evidence", "on_success", "on_failure"
      ],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "ordinal": {"type": "integer", "minimum": 1},
        "stage_class": {"type": "string", "minLength": 1},
        "terminal": {"type": "boolean"},
        "terminal_state": {"type": ["string", "null"]},
        "inputs": {"$ref": "#/$defs/stringArray"},
        "outputs": {"$ref": "#/$defs/stringArray"},
        "side_effect": {
          "enum": ["read-only", "workspace-write", "read-only-or-test-temporary-write", "decision-only", "external-write"]
        },
        "approval": {
          "enum": ["none", "task-scope", "implementation-permission", "independent-review", "review-passed", "human-owner", "human-owner-and-target-policy"]
        },
        "retry": {
          "enum": ["bounded-safe", "bounded-with-readback", "bounded-after-hypothesis-update", "only-after-input-or-implementation-change", "only-after-finding-disposition", "forbidden-without-new-owner-input", "idempotency-key-required"]
        },
        "timeout": {"const": "target-runtime-owned-required"},
        "cancellation": {"const": "target-runtime-must-report-terminal-state"},
        "idempotency": {"enum": ["required", "required-or-idempotency-key"]},
        "checkpoint": {"type": "boolean"},
        "rollback": {
          "enum": ["not-applicable", "workspace-anchor", "required-before-entry", "restore-pre-archive-state", "superseding-decision-required", "target-specific-rollback-required"]
        },
        "required_evidence": {"$ref": "#/$defs/stringArray"},
        "on_success": {"type": "string", "minLength": 1},
        "on_failure": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"side_effect": {"const": "workspace-write"}}},
          "then": {"properties": {"approval": {"enum": ["task-scope", "implementation-permission", "review-passed"]}}}
        },
        {
          "if": {"properties": {"side_effect": {"const": "external-write"}}},
          "then": {
            "properties": {
              "approval": {"const": "human-owner-and-target-policy"},
              "idempotency": {"const": "required-or-idempotency-key"},
              "rollback": {"const": "target-specific-rollback-required"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["from", "to", "condition"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "condition": {"enum": ["success", "failure", "cancel", "rollback"]}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "workflow_id", "version", "description", "command_risk", "primary_agent", "primary_skill",
        "profiles", "entry_conditions", "exit_evidence", "artifacts", "verification", "failure_handling",
        "stage_contract_sha256", "nodes", "transitions"
      ],
      "properties": {
        "workflow_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "command_risk": {"enum": ["low", "medium", "high"]},
        "primary_agent": {"type": "string", "minLength": 1},
        "primary_skill": {"type": "string", "minLength": 1},
        "profiles": {"$ref": "#/$defs/stringArray"},
        "entry_conditions": {"$ref": "#/$defs/stringArray"},
        "exit_evidence": {"$ref": "#/$defs/stringArray"},
        "artifacts": {"$ref": "#/$defs/stringArray"},
        "verification": {"$ref": "#/$defs/stringArray"},
        "failure_handling": {"$ref": "#/$defs/stringArray"},
        "stage_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "transitions": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/transition"}}
      },
      "additionalProperties": false
    }
  }
}
