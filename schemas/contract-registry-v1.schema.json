{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-kit.local/schemas/contract-registry-v1.json",
  "title": "ADK versioned contract registry",
  "type": "object",
  "required": ["schema", "contracts"],
  "properties": {
    "schema": {"const": "adk-contract-registry/v1"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "owner", "producer", "consumers", "stability", "compatibility"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "version": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "producer": {"type": "string", "minLength": 1},
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "stability": {"enum": ["experimental", "rc", "stable"]},
          "compatibility": {"enum": ["strict", "backward-compatible", "hard-cut"]},
          "schema_path": {"type": ["string", "null"], "minLength": 1},
          "surface_path": {"type": ["string", "null"], "minLength": 1},
          "evidence_class": {"enum": ["source", "test", "runtime", "field", "release"]}
        },
        "anyOf": [
          {"required": ["schema_path"]},
          {"required": ["surface_path"]}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
