{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-kit.local/schemas/native-target-campaign-plan-v1.json",
  "title": "ADK native target campaign plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "campaign_id",
    "target",
    "profile",
    "asset_kind",
    "source_version",
    "source_contract_sha256",
    "candidate_contract_sha256",
    "candidate_contract_normalized_sha256",
    "bundle_sha256",
    "bundle_files",
    "runtime",
    "authority",
    "auth_mode",
    "timeout_seconds",
    "receipt_path",
    "command_sha256",
    "privacy",
    "lifecycle_authority",
    "release_authorized"
  ],
  "properties": {
    "schema": {
      "const": "adk-native-target-campaign-plan/v1"
    },
    "status": {
      "const": "ready"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^native-[0-9a-f]{24}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "asset_kind": {
      "const": "skill"
    },
    "source_version": {
      "$ref": "#/$defs/version"
    },
    "source_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_contract_normalized_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "bundle_files": {
      "type": "integer",
      "minimum": 1
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_authority",
        "authority_id",
        "verification_backend"
      ],
      "properties": {
        "execution_authority": {
          "enum": [
            "human-approved",
            "ci-approved"
          ]
        },
        "authority_id": {
          "$ref": "#/$defs/id"
        },
        "verification_backend": {
          "enum": [
            "external-signature-verifier",
            "ci-provenance-verifier"
          ]
        }
      }
    },
    "auth_mode": {
      "enum": [
        "none",
        "home"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "receipt_path": {
      "type": "string",
      "pattern": "^reports/runtime/[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "command_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "discovery",
        "load",
        "trigger"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/sha256"
        },
        "discovery": {
          "$ref": "#/$defs/sha256"
        },
        "load": {
          "$ref": "#/$defs/sha256"
        },
        "trigger": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_command_stored",
        "raw_output_stored",
        "credentials_stored"
      ],
      "properties": {
        "raw_command_stored": {
          "const": false
        },
        "raw_output_stored": {
          "const": false
        },
        "credentials_stored": {
          "const": false
        }
      }
    },
    "lifecycle_authority": {
      "const": "none-campaign-only"
    },
    "release_authorized": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]*$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary",
        "binary_sha256",
        "version",
        "version_pin"
      ],
      "properties": {
        "binary": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "version_pin": {
          "$ref": "#/$defs/version"
        }
      }
    }
  }
}
