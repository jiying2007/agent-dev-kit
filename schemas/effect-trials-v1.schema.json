{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded repeated effect test campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan",
    "trials"
  ],
  "properties": {
    "schema_version": {
      "const": "adk-effect-trials/v1"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "registered_at",
        "window",
        "task_ids",
        "trial_ids",
        "bundles",
        "controls",
        "policy"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "through",
            "as_of"
          ],
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "through": {
              "type": "string",
              "format": "date-time"
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "uniqueItems": true
        },
        "trial_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "uniqueItems": true
        },
        "bundles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "candidate"
          ],
          "properties": {
            "baseline": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "candidate": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime_target",
            "runtime_version",
            "model_version",
            "prompt_version",
            "orchestration_mode",
            "environment_ref",
            "tool_policy_ref",
            "grader_ref",
            "dataset_ref",
            "parameters_ref",
            "provider_ref",
            "model_identity"
          ],
          "properties": {
            "runtime_target": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "runtime_version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "model_version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "prompt_version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "orchestration_mode": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "environment_ref": {
              "type": "string",
              "pattern": "^ref:[0-9a-f]{64}$"
            },
            "tool_policy_ref": {
              "type": "string",
              "pattern": "^ref:[0-9a-f]{64}$"
            },
            "grader_ref": {
              "type": "string",
              "pattern": "^ref:[0-9a-f]{64}$"
            },
            "dataset_ref": {
              "type": "string",
              "pattern": "^ref:[0-9a-f]{64}$"
            },
            "parameters_ref": {
              "type": "string",
              "pattern": "^ref:[0-9a-f]{64}$"
            },
            "provider_ref": {
              "type": "string",
              "pattern": "^ref:[0-9a-f]{64}$"
            },
            "model_identity": {
              "enum": [
                "revision-bound",
                "alias-unverified"
              ]
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_metric",
            "minimum_effect",
            "noninferiority_margin",
            "guardrails",
            "minimum_tasks",
            "minimum_trials",
            "bootstrap_samples",
            "bootstrap_seed",
            "confidence"
          ],
          "properties": {
            "primary_metric": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "minimum_effect": {
              "type": "number",
              "minimum": 0
            },
            "noninferiority_margin": {
              "type": "number",
              "minimum": 0
            },
            "guardrails": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 7,
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "minimum_tasks": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1000
            },
            "minimum_trials": {
              "type": "integer",
              "minimum": 2,
              "maximum": 100
            },
            "bootstrap_samples": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            },
            "bootstrap_seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "confidence": {
              "type": "number",
              "minimum": 0.8,
              "maximum": 0.99
            }
          }
        }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "infrastructure_status",
          "baseline",
          "candidate"
        ],
        "properties": {
          "trial_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "infrastructure_status": {
            "enum": [
              "ok",
              "failed"
            ]
          },
          "baseline": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "plan_ref",
                "controls_ref",
                "run"
              ],
              "properties": {
                "plan_ref": {
                  "type": "string",
                  "pattern": "^ref:[0-9a-f]{64}$"
                },
                "controls_ref": {
                  "type": "string",
                  "pattern": "^ref:[0-9a-f]{64}$"
                },
                "run": {
                  "type": "object"
                }
              }
            }
          },
          "candidate": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "plan_ref",
                "controls_ref",
                "run"
              ],
              "properties": {
                "plan_ref": {
                  "type": "string",
                  "pattern": "^ref:[0-9a-f]{64}$"
                },
                "controls_ref": {
                  "type": "string",
                  "pattern": "^ref:[0-9a-f]{64}$"
                },
                "run": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}