{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-kit.local/schemas/evidence-graph-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "graph_kind", "generated_at", "nodes", "edges", "raw_content_stored"],
  "properties": {
    "schema_version": {"const": "adk-evidence-graph/v1"},
    "graph_id": {"$ref": "#/$defs/identifier"},
    "graph_kind": {"enum": ["partial", "release-evidence"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "raw_content_stored": {"const": false}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "opaqueRef": {"type": "string", "pattern": "^ref:[0-9a-f]{64}$"},
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "path", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/opaqueRef"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outcomeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_success", "first_pass_success", "human_interventions", "elapsed_ms", "input_tokens", "output_tokens", "tool_calls", "wrong_skill", "abstained"],
      "properties": {
        "task_success": {"type": "boolean"},
        "first_pass_success": {"type": "boolean"},
        "human_interventions": {"type": "integer", "minimum": 0},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "wrong_skill": {"type": "boolean"},
        "abstained": {"type": "boolean"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "content_sha256", "evidence_ref", "evidence_layer", "owner", "verified_at", "expires_at", "sensitivity", "retention", "attributes"],
      "properties": {
        "node_id": {"$ref": "#/$defs/identifier"},
        "node_type": {"enum": ["source", "decision", "asset", "bundle", "runtime", "trace", "outcome", "release", "rollback", "retirement"]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_ref": {"$ref": "#/$defs/evidenceRef"},
        "evidence_layer": {"enum": ["source", "test", "runtime", "field"]},
        "owner": {"$ref": "#/$defs/identifier"},
        "verified_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "sensitivity": {"enum": ["public", "team-internal", "restricted-metadata"]},
        "retention": {"enum": ["keep-current", "keep-provenance", "expire", "supersede", "retire"]},
        "attributes": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"node_type": {"const": "outcome"}}, "required": ["node_type"]},
          "then": {"properties": {"attributes": {"$ref": "#/$defs/outcomeMetrics"}}},
          "else": {"properties": {"attributes": {"type": "object", "maxProperties": 0}}}
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relation"],
      "properties": {
        "from": {"$ref": "#/$defs/identifier"},
        "to": {"$ref": "#/$defs/identifier"},
        "relation": {"enum": ["informs", "authorizes", "compiled-into", "loaded-by", "emits", "evaluated-as", "supports", "rehearsed-with", "retired-by", "superseded-by"]}
      }
    }
  }
}
