{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adk-content-architecture-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_source",
    "baseline_source_commit",
    "identity_baseline",
    "agent_thin_contract",
    "production_behavior_without_authority"
  ],
  "properties": {
    "schema_version": {"const": "adk-content-architecture-policy/v1"},
    "identity_source": {"const": "manifest.json"},
    "baseline_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_count", "core_skill_count", "optional_skill_count"],
      "properties": {
        "agent_count": {"type": "integer", "minimum": 1},
        "core_skill_count": {"type": "integer", "minimum": 1},
        "optional_skill_count": {"type": "integer", "minimum": 0}
      }
    },
    "agent_thin_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0_max_bytes",
        "p1_max_bytes",
        "required_headings",
        "forbidden_procedure_headings",
        "forbid_shell_code_fences"
      ],
      "properties": {
        "p0_max_bytes": {"type": "integer", "minimum": 1},
        "p1_max_bytes": {"type": "integer", "minimum": 1},
        "required_headings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_procedure_headings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbid_shell_code_fences": {"const": true}
      }
    },
    "production_behavior_without_authority": {"const": "not-measured"}
  }
}
