{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-kit.local/schemas/native-target-campaign-evidence-v1.json",
  "title": "ADK native target campaign evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "campaign_id",
    "target",
    "profile",
    "runtime",
    "bundle_sha256",
    "candidate_contract_normalized_sha256",
    "version_probe",
    "stages",
    "privacy",
    "lifecycle_authority",
    "release_authorized"
  ],
  "properties": {
    "schema": {
      "const": "adk-native-target-campaign-evidence/v1"
    },
    "status": {
      "enum": [
        "complete",
        "failed",
        "blocked"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^native-[0-9a-f]{24}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_contract_normalized_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "version_probe": {
      "$ref": "#/$defs/probe"
    },
    "stages": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_command_stored",
        "raw_output_stored",
        "credentials_stored"
      ],
      "properties": {
        "raw_command_stored": {
          "const": false
        },
        "raw_output_stored": {
          "const": false
        },
        "credentials_stored": {
          "const": false
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle_authority": {
      "const": "none-campaign-only"
    },
    "release_authorized": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "required": [
          "completed_at"
        ],
        "properties": {
          "stages": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "stage": {
                      "const": "discovery"
                    },
                    "status": {
                      "const": "pass"
                    }
                  },
                  "required": [
                    "stage",
                    "status"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "stage": {
                      "const": "load"
                    },
                    "status": {
                      "const": "pass"
                    }
                  },
                  "required": [
                    "stage",
                    "status"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "stage": {
                      "const": "trigger"
                    },
                    "status": {
                      "const": "pass"
                    }
                  },
                  "required": [
                    "stage",
                    "status"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]*$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary",
        "binary_sha256",
        "version",
        "version_pin"
      ],
      "properties": {
        "binary": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "version_pin": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "duration_ms",
        "stdout_bytes",
        "stdout_sha256",
        "stderr_bytes",
        "stderr_sha256"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "cwd_sha256",
        "environment_sha256",
        "runtime_binary_sha256",
        "bundle_sha256"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cwd_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_content_stored",
        "secrets_stored",
        "sanitized"
      ],
      "properties": {
        "raw_content_stored": {
          "const": false
        },
        "secrets_stored": {
          "const": false
        },
        "sanitized": {
          "const": true
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "status",
        "command_sha256"
      ],
      "properties": {
        "stage": {
          "enum": [
            "discovery",
            "load",
            "trigger"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "exit_code": {
          "type": "integer"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "privacy": {
          "$ref": "#/$defs/privacy"
        }
      }
    }
  }
}
