{
  "schema_version": "adk-workflow-ir-policy/v1",
  "ir_schema_version": "adk-workflow-ir/v2",
  "last_updated": "2026-08-30",
  "runtime_boundary": "This policy compiles and validates workflow semantics. It does not execute models, tools, schedulers, durable workers or external writes.",
  "allowed_command_risks": ["low", "medium", "high"],
  "timeout_policy": "target-runtime-owned-required",
  "cancellation_policy": "target-runtime-must-report-terminal-state",
  "unknown_stage_policy": "fail-closed",
  "terminal_states": [
    "complete",
    "cancelled",
    "rollback-required",
    "stop-needs-evidence",
    "return-previous",
    "return-diagnose-or-design",
    "return-implementation",
    "hold-review-passed",
    "hold-owner",
    "stop-reconcile-external"
  ],
  "edge_conditions": ["success", "failure", "cancel", "rollback"],
  "projection_digests": {
    "adk-delivery-gate": "5981aa9491c054bc3ce8f94add00faf84766fe9f270854db2a57cbe300e3fcba",
    "bugfix-delivery": "bb126f2b98f6e24f472e7c47ae5fd9d7a25b75a885d42b85e936e2f0578955ef",
    "external-practice-absorption": "231e6db158fd2fc391e78e9cdc2f74769dc44aaf6ff485a879cb5478adc57e37",
    "feature-delivery": "72e88d8b32e603e95c24f759824ad75edc879109af89f9ca55529251782a9477",
    "release-hardening": "e70f0fe2aac4baa7d7b5dcef24a9ccc26b984114cc04834d35d51042ab2e4e12",
    "runtime-routing": "4e93ff8f55ae394eebe6df1057a0c837e54bb840a5e1778f2d3cd44a64652a95",
    "skill-curation-delivery": "609e31174dc2c1b64c0b88f973038f54f08c3824b58f6d196e312ae21cf71744"
  },
  "stage_classes": {
    "read-only": {
      "side_effect": "read-only",
      "approval": "none",
      "retry": "bounded-safe",
      "idempotency": "required",
      "checkpoint": false,
      "rollback": "not-applicable",
      "failure_transition": "stop-needs-evidence",
      "input_refs": ["workflow-input"],
      "output_refs": ["decision-or-observation"],
      "required_evidence": ["input-snapshot", "decision-or-observation"]
    },
    "design-write": {
      "side_effect": "workspace-write",
      "approval": "task-scope",
      "retry": "bounded-with-readback",
      "idempotency": "required",
      "checkpoint": true,
      "rollback": "workspace-anchor",
      "failure_transition": "return-previous",
      "input_refs": ["workflow-input", "previous-stage-output"],
      "output_refs": ["versioned-workspace-artifact"],
      "required_evidence": ["artifact-readback", "scope-boundary"]
    },
    "implementation": {
      "side_effect": "workspace-write",
      "approval": "implementation-permission",
      "retry": "bounded-after-hypothesis-update",
      "idempotency": "required-or-idempotency-key",
      "checkpoint": true,
      "rollback": "required-before-entry",
      "failure_transition": "return-diagnose-or-design",
      "input_refs": ["approved-design", "scoped-task"],
      "output_refs": ["change-artifact", "rollback-anchor"],
      "required_evidence": ["change-artifact", "rollback-anchor", "negative-result"]
    },
    "verification": {
      "side_effect": "read-only-or-test-temporary-write",
      "approval": "none",
      "retry": "only-after-input-or-implementation-change",
      "idempotency": "required",
      "checkpoint": true,
      "rollback": "not-applicable",
      "failure_transition": "return-implementation",
      "input_refs": ["change-artifact", "expected-assertions"],
      "output_refs": ["verification-result", "evidence-index"],
      "required_evidence": ["command", "exit-code", "result-summary", "evidence-path"]
    },
    "review": {
      "side_effect": "read-only",
      "approval": "independent-review",
      "retry": "only-after-finding-disposition",
      "idempotency": "required",
      "checkpoint": true,
      "rollback": "not-applicable",
      "failure_transition": "return-implementation",
      "input_refs": ["change-artifact", "verification-result"],
      "output_refs": ["review-verdict", "finding-dispositions"],
      "required_evidence": ["blocker-count", "major-count", "minor-count", "verdict"]
    },
    "archive": {
      "side_effect": "workspace-write",
      "approval": "review-passed",
      "retry": "bounded-with-readback",
      "idempotency": "required",
      "checkpoint": true,
      "rollback": "restore-pre-archive-state",
      "failure_transition": "hold-review-passed",
      "input_refs": ["review-verdict", "retention-decision"],
      "output_refs": ["archive-readback"],
      "required_evidence": ["review-verdict", "retention-decision", "archive-readback"]
    },
    "owner-decision": {
      "side_effect": "decision-only",
      "approval": "human-owner",
      "retry": "forbidden-without-new-owner-input",
      "idempotency": "required",
      "checkpoint": true,
      "rollback": "superseding-decision-required",
      "failure_transition": "hold-owner",
      "input_refs": ["decision-request", "evidence-summary"],
      "output_refs": ["owner-attestation"],
      "required_evidence": ["decision-id", "decision-scope", "owner-attestation"]
    },
    "external-publish": {
      "side_effect": "external-write",
      "approval": "human-owner-and-target-policy",
      "retry": "idempotency-key-required",
      "idempotency": "required-or-idempotency-key",
      "checkpoint": true,
      "rollback": "target-specific-rollback-required",
      "failure_transition": "stop-reconcile-external",
      "input_refs": ["authorization", "target-plan"],
      "output_refs": ["external-readback", "reconciliation-state"],
      "required_evidence": ["authorization", "target-plan", "idempotency-key", "external-readback"]
    }
  },
  "stage_bindings": {
    "inventory": "read-only",
    "discover": "read-only",
    "normalize": "read-only",
    "reproduce": "read-only",
    "diagnose": "read-only",
    "triage": "read-only",
    "baseline": "read-only",
    "intake": "read-only",
    "classify": "read-only",
    "route-design": "design-write",
    "runtime-control-plane-audit": "read-only",
    "closure-check": "verification",
    "contract": "design-write",
    "propose": "design-write",
    "decide": "owner-decision",
    "apply": "implementation",
    "implement": "implementation",
    "harden": "implementation",
    "verify": "verification",
    "pilot": "verification",
    "review": "review",
    "review-retire": "review",
    "release-decision": "owner-decision",
    "archive": "archive",
    "publish": "external-publish"
  }
}
