{
  "schema_version": "1.0.0",
  "last_updated": "2026-07-06",
  "source_docs": [
    "openai-codex-plugin-build",
    "openai-codex-plugin-marketplace"
  ],
  "reference_boundary": "OpenAI/Codex source docs are citation metadata and governance references only. This manifest promotes platform-neutral ADK plugin packaging contracts and must not enable Codex marketplace installs, hooks, external runtimes, user-directory writes, or compatibility defaults.",
  "plugin_contracts": [
    {
      "id": "minimal-skill-plugin",
      "owner": "agent-dev-kit",
      "required_files": [
        ".adk-plugin/plugin.json",
        "skills/<skill-name>/SKILL.md"
      ],
      "naming": {
        "plugin_name": "stable kebab-case",
        "component_namespace": "derived from plugin name"
      },
      "allowed_extensions": [
        "mcp config",
        "app integrations",
        "marketplace metadata"
      ],
      "required_review": [
        "version metadata",
        "publisher metadata",
        "install-surface copy",
        "auth policy",
        "source path containment",
        "hook registration policy",
        "deterministic packaging evidence",
        "per-skill OpenAI metadata",
        "cross-harness invocation parity"
      ]
    }
  ],
  "codex_plugin_packaging": {
    "id": "codex-plugin-portal-package",
    "owner": "agent-dev-kit",
    "required_manifest_checks": [
      "explicit hooks policy",
      "category",
      "publisher",
      "version",
      "skills metadata"
    ],
    "no_hooks_policy": {
      "disabled_value": "hooks: {}",
      "must_not_use": [
        "absent hooks field",
        "hooks: []",
        "empty inline hook list"
      ],
      "reason": "Codex marketplace installers can fall back to auto-discovering root hook files when the manifest omits an explicit empty hooks object."
    },
    "package_requirements": [
      "refuse dirty worktree",
      "normalize archive entry timestamps",
      "preserve executable modes",
      "verify each packaged skill ships OpenAI metadata",
      "include declared app/composer icons",
      "support reproducible rebuild from saved metadata source"
    ]
  },
  "marketplace_contracts": [
    {
      "id": "repo-marketplace",
      "owner": "agent-dev-kit",
      "path": "$REPO_ROOT/.agents/plugins/marketplace.json",
      "required_fields": [
        "name",
        "interface.displayName",
        "plugins[].source.path",
        "plugins[].policy.installation",
        "plugins[].policy.authentication",
        "plugins[].category"
      ],
      "source_path_policy": "relative path must start with ./ and stay inside marketplace root",
      "install_policy_values": [
        "AVAILABLE",
        "INSTALLED_BY_DEFAULT",
        "NOT_AVAILABLE"
      ],
      "failure_policy": "unresolvable plugin source skips that plugin entry rather than failing the whole marketplace"
    },
    {
      "id": "personal-marketplace",
      "owner": "agent-dev-kit",
      "path": "~/.agents/plugins/marketplace.json",
      "required_fields": [
        "name",
        "interface.displayName",
        "plugins[].source.path",
        "plugins[].policy.installation",
        "plugins[].policy.authentication",
        "plugins[].category"
      ],
      "source_path_policy": "local personal entries should prefer ./.adk/plugins/<plugin-name> when testing",
      "install_policy_values": [
        "AVAILABLE",
        "INSTALLED_BY_DEFAULT",
        "NOT_AVAILABLE"
      ],
      "failure_policy": "do not promote personal marketplace entries into adk without source and auth review"
    }
  ]
}
