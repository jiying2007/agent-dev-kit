  "asset_lifecycle": {
    "applies_to": ["agent", "skill", "profile"],
    "identity_resolution": "resolve-current-manifest-at-validation-time",
    "retirement_signals": ["retain", "consolidate-candidate", "retire-candidate", "insufficient-evidence"],
    "retirement_authority": "signal-only-owner-decision-required",
    "minimum_retirement_evidence": [
      "multiple-measured-invocations",
      "representative-success-and-failure",
      "wrong-route-and-abstain-analysis",
      "replacement-or-removal-impact",
      "owner-review"
    ]
  },
  "quality_kpi_policy": {
    "quality_kpis": [
      "task-success-rate",
      "first-pass-success-rate",
      "wrong-route-rate",
      "abstain-precision",
      "human-interventions-per-task",
      "time-to-trustworthy-change",
      "escaped-defect-rate",
      "rollback-rate"
    ],
    "diagnostic_only": [
      "agent-count",
      "skill-count",
      "profile-count",
      "invocation-count",
      "pr-count",
      "report-count",
      "input-tokens",
      "output-tokens",
      "total-tokens"
    ],
    "decision_rule": "Consolidation or retirement requires measured outcome evidence and owner review; volume and token diagnostics cannot prove quality."
  },
  "must_not": [
    "copy Agent Skill or Profile identity metadata from manifest into a parallel catalog",
    "treat invocation count asset count pull request count report count or token volume as a quality KPI",
    "emit or persist synthetic usage as runtime or field evidence",
    "enable production authority or quality evidence eligibility through an input contract callback or temporary registry",
    "store prompts messages raw logs credentials tool payloads or operator identity",
    "treat a retirement signal as deletion disablement or owner approval",
    "grant permission beyond the current manifest permission profile"
  ]
}
