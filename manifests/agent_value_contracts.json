{
  "schema_version": "adk-agent-value-contracts/v1",
  "last_updated": "2026-08-30",
  "identity_source": "manifest.json",
  "boundary": "This contract references current manifest identities and defines value-governance semantics only. The explicit emit_measurements API may derive scoped measurements from validated receipt inputs, but it does not collect or automatically persist receipts or measurements, claim global runtime usage, enable a runtime, grant permissions, or authorize consolidation, promotion, or retirement. Test receipts are structural-only evidence. Runtime and field receipts require an enabled managed authority registry, a scope-bound authority attestation, and an injected external verifier; the canonical policy is disabled and has no configured authorities. V1 accepts only non-production authority entries and always reports quality evidence as ineligible; production authority requires a separate versioned managed-registry change.",
  "receipt_contract": {
    "schema_path": "schemas/asset-invocation-receipt-v1.schema.json",
    "schema_version": "adk-asset-invocation-receipt/v1",
    "measurement_schema_path": "schemas/asset-value-measurement-v1.schema.json",
    "measurement_schema_version": "adk-asset-value-measurement/v1",
    "required_measurement_status": "measured",
    "max_age_days": 30,
    "evidence_ref_format": "ref:<sha256>",
    "opaque_ref_fields": ["receipt_id", "invocation_ref", "source_trace_ref", "manifest_ref", "evidence_refs[]"]
  },
  "emitter": {
    "status": "not-measured",
    "runtime_enabled": false,
    "usage_evidence": "none-claimed",
    "activation_requirement": "A reviewed runtime adapter must emit measured, schema-valid, sanitized receipts with durable evidence references.",
    "input_mode": "explicit-validated-receipts-only",
    "measured_transition": "at-least-one-valid-receipt",
    "missing_metric_policy": "explicit-not-measured-never-zero",
    "evidence_layer_policy": "never-mix-test-runtime-field",
    "api_status": "available",
    "api": "emit_measurements",
    "automatic_runtime_integration": false
  },
  "evidence_authority_policy": {
    "managed": true,
    "status": "disabled",
    "backend": "not-configured",
    "authorities": []
  },
  "permission_profiles": {
