      "per_tool_approval_mode",
      "tool_hints",
      "auth_boundary",
      "pii_policy",
      "dry_run",
      "fallback"
    ],
    "must_not": [
      "make unknown external MCP servers required by default",
      "store bearer tokens in manifests or project config",
      "enable destructive tools with approve mode before dry-run and rollback evidence"
    ]
  },
