  "reference_boundary": "OpenAI/Codex source docs are citation metadata and governance references only. This manifest promotes platform-neutral ADK tool and MCP dependency contracts and must not enable external MCP servers, write-capable tools, hosted services, user-directory writes, or compatibility defaults.",
  "tool_description_policy": {
    "required_elements": [
      "action-oriented name",
      "Use this when guidance",
      "disallowed or edge cases",
      "required input shape",
      "parameter descriptions and enums when applicable",
      "side-effect and approval class"
    ],
    "review_payloads": "Write-capable tools must expose JSON payloads for human or deterministic policy review before execution.",
    "remembered_approvals": "Conversation-local approval remembers are not durable adk permission grants."
  },
  "external_dependency_provenance_policy": {
    "id": "mcp-dependency-provenance-v1",
    "source_refs": [
      "mcp-registry"
    ],
    "required_fields": [
      "source_url",
      "registry_namespace",
      "namespace_verification",
      "package_version",
      "artifact_digest",
      "retrieved_at",
      "review_status",
      "expires_at",
      "trust_decision"
    ],
    "trust_model": {
      "registry_listing": "discovery metadata only",
      "namespace_ownership": "publisher identity evidence, not artifact safety proof",
      "artifact_integrity": "version plus digest or an explicit remote-service exception",
      "promotion": "requires security review, runtime boundary, verification and rollback"
    },
    "quality_gates": [
      "every MCP dependency records provenance before enablement",
      "mutable latest references are forbidden for executable artifacts",
      "review_status and expires_at must be current at promotion time",
      "registry namespace verification cannot replace artifact or runtime review"
    ],
    "must_not": [
      "auto-install a registry entry",
      "treat registry presence as trust certification",
      "enable an executable MCP package without a version and digest",
      "store registry or provider credentials in the manifest"
    ]
  },
  "data_only_mcp_compatibility": {
    "preferred_tools": [
      "search",
      "fetch"
    ],
    "search_required_output": [
      "structuredContent.results[].id",
      "structuredContent.results[].title",
      "structuredContent.results[].url"
    ],
    "fetch_required_output": [
      "structuredContent.id",
      "structuredContent.title",
      "structuredContent.text",
      "structuredContent.url"
    ],
    "compatibility_note": "For clients that require content-array compatibility, include the same JSON value as a text content item without leaking secrets.",
    "risk_review": [
      "prompt injection in indexed content",
      "sensitive-data exfiltration through read queries",
      "write action confusion when readOnlyHint is missing or wrong",
      "untrusted custom MCP server ownership"
    ]
  },
