{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-kit.local/schemas/manifest-3.1.0.json",
  "title": "agent-dev-kit manifest 3.1",
  "type": "object",
  "required": [
    "version",
    "locale",
    "platforms",
    "reference_sources",
    "external_handoff_targets",
    "tool_targets",
    "quality_tiers",
    "asset_taxonomy",
    "knowledge_layers",
    "context_layers",
    "embedded_context_layers",
    "knowledge_types",
    "knowledge_maturity",
    "agents",
    "skills",
    "default_profile",
    "profiles",
    "workflows",
    "mcp_servers",
    "change_sets",
    "optional_skills",
    "install",
    "skill_routing_matrix",
    "routing",
    "dependencies",
    "schema_version",
    "product"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "locale": {"type": "string", "minLength": 2},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reference_sources": {"type": "object"},
    "external_handoff_targets": {"type": "object"},
    "tool_targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/directTarget"}
    },
    "quality_tiers": {"type": "object"},
    "asset_taxonomy": {"type": "object"},
    "knowledge_layers": {"type": "object"},
    "context_layers": {"type": "object"},
    "embedded_context_layers": {"type": "object"},
    "knowledge_types": {"type": "object"},
    "knowledge_maturity": {"type": "object"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/agent"}
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    },
    "default_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    },
    "mcp_servers": {"type": "array"},
    "change_sets": {"type": "array"},
    "optional_skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "install": {"type": "object"},
    "skill_routing_matrix": {"type": "array"},
    "routing": {"type": "object"},
    "dependencies": {"type": "object"},
    "schema_version": {"const": "3.1.0"},
    "product": {
      "type": "object",
      "required": ["kind", "runtime_boundary", "evidence_model"],
      "properties": {
        "kind": {"const": "agent-asset-platform"},
        "runtime_boundary": {"const": "no-llm-runner"},
        "evidence_model": {"const": "source-test-runtime-field"}
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9-]*$": {}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "agent": {
      "allOf": [
        {"$ref": "#/$defs/asset"},
        {
          "type": "object",
          "required": ["description", "permission_profile"],
          "properties": {
            "permission_profile": {
              "enum": ["read-only", "code-write", "build-release", "diagnostic"]
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "description": {"type": "string"},
        "trigger_examples": {"type": "array", "items": {"type": "string"}},
        "extends": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "include_agents": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "include_skills": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "directTarget": {
      "type": "object",
      "required": [
        "display_name",
        "status",
        "contract",
        "supported_asset_kinds",
        "default_root",
        "agents_dir",
        "skills_dir",
        "detect"
      ],
      "properties": {
        "display_name": {"type": "string", "minLength": 1},
        "status": {"enum": ["experimental", "stable"]},
        "contract": {
          "type": "string",
          "pattern": "^manifests/target-contracts/[a-z0-9-]+\\.json$"
        },
        "supported_asset_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["agent", "skill"]}
        },
        "default_root": {"type": "string", "minLength": 1},
        "agents_dir": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "skills_dir": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "detect": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
