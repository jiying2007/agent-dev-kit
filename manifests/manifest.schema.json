{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-kit.local/schemas/manifest-4.0.0.json",
  "title": "agent-dev-kit manifest schema 4.0",
  "type": "object",
  "required": [
    "version",
    "locale",
    "platforms",
    "reference_sources",
    "external_handoff_targets",
    "tool_targets",
    "quality_tiers",
    "asset_taxonomy",
    "knowledge_layers",
    "context_layers",
    "embedded_context_layers",
    "knowledge_types",
    "knowledge_maturity",
    "agents",
    "skills",
    "default_profile",
    "profiles",
    "workflows",
    "mcp_servers",
    "skill_invocation",
    "change_sets",
    "optional_skills",
    "install",
    "skill_routing_matrix",
    "routing",
    "dependencies",
    "schema_version",
    "product"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference_sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/referenceSource"
      }
    },
    "external_handoff_targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/externalHandoffTarget"
      }
    },
    "tool_targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/directTarget"
      }
    },
    "quality_tiers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^p[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/qualityTier"
      }
    },
    "asset_taxonomy": {
      "$ref": "#/$defs/assetTaxonomy"
    },
    "knowledge_layers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^L[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/knowledgeLayer"
      }
    },
    "context_layers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^L[0-9]+-[a-z0-9-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/contextLayer"
      }
    },
    "embedded_context_layers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^L[0-9]+-[a-z0-9-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/contextLayer"
      }
    },
    "knowledge_types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/knowledgeDescriptor"
      }
    },
    "knowledge_maturity": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/knowledgeDescriptor"
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "default_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "mcp_servers": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "skill_invocation": {
      "$ref": "#/$defs/skillInvocation"
    },
    "change_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/changeSet"
      }
    },
    "optional_skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "install": {
      "$ref": "#/$defs/install"
    },
    "skill_routing_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skillRouting"
      }
    },
    "routing": {
      "$ref": "#/$defs/routing"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "schema_version": {
      "const": "4.0.0"
    },
    "product": {
      "type": "object",
      "required": [
        "kind",
        "runtime_boundary",
        "evidence_model"
      ],
      "properties": {
        "kind": {
          "const": "agent-asset-platform"
        },
        "runtime_boundary": {
          "const": "no-llm-runner"
        },
        "evidence_model": {
          "const": "source-test-runtime-field"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9-]*$": {}
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assetNameArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "referenceSource": {
      "type": "object",
      "required": [
        "display_name",
        "source_type",
        "boundary",
        "runtime_enablement",
        "governance_manifest"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "runtime_enablement": {
          "const": false
        },
        "governance_manifest": {
          "type": "string",
          "pattern": "^manifests/[a-z0-9_.-]+\\.json$"
        }
      },
      "additionalProperties": false
    },
    "externalHandoffTarget": {
      "type": "object",
      "required": [
        "display_name",
        "runtime",
        "handoff_mode",
        "direct_tool_target",
        "handoff_chain",
        "owner_review_required",
        "default_enabled",
        "notes",
        "must_not"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "handoff_mode": {
          "const": "source-to-live"
        },
        "direct_tool_target": {
          "const": false
        },
        "handoff_chain": {
          "type": "string",
          "minLength": 1
        },
        "owner_review_required": {
          "const": true
        },
        "default_enabled": {
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "must_not": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "qualityTier": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "skillInvocation": {
      "type": "object",
      "required": [
        "default_mode",
        "overrides"
      ],
      "properties": {
        "default_mode": {
          "enum": [
            "implicit",
            "explicit-only"
          ]
        },
        "overrides": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "enum": [
              "implicit",
              "explicit-only"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "taxonomyEntry": {
      "type": "object",
      "required": [
        "name",
        "lifecycle_order",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "lifecycle_order": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "assetTaxonomy": {
      "type": "object",
      "required": [
        "skill_categories",
        "workflow_types",
        "skill_patterns",
        "activation_modes"
      ],
      "properties": {
        "skill_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/taxonomyEntry"
          }
        },
        "workflow_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/taxonomyEntry"
          }
        },
        "skill_patterns": {
          "$ref": "#/$defs/stringArray"
        },
        "activation_modes": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "knowledgeLayer": {
      "type": "object",
      "required": [
        "name",
        "description",
        "location"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "knowledgeDescriptor": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "contextLayer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "description",
            "max_tokens",
            "files"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "files": {
              "$ref": "#/$defs/stringArray"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "description",
            "sources"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "$ref": "#/$defs/stringArray"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "changeSet": {
      "type": "object",
      "required": [
        "name",
        "description",
        "root",
        "archive_root",
        "commands",
        "required_files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "archive_root": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^rtk "
          },
          "uniqueItems": true
        },
        "required_files": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "required": [
        "default_mode",
        "supported_modes",
        "backup_before_install",
        "lock_version"
      ],
      "properties": {
        "default_mode": {
          "const": "copy"
        },
        "supported_modes": {
          "const": [
            "copy"
          ]
        },
        "backup_before_install": {
          "type": "boolean"
        },
        "lock_version": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "routingIntent": {
      "type": "object",
      "required": [
        "intent",
        "intent_zh",
        "primary_skill",
        "supporting_skills"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "intent_zh": {
          "type": "string",
          "minLength": 1
        },
        "primary_skill": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "supporting_skills": {
          "$ref": "#/$defs/assetNameArray"
        },
        "fallback_skills": {
          "$ref": "#/$defs/assetNameArray"
        },
        "mutually_exclusive": {
          "$ref": "#/$defs/assetNameArray"
        },
        "availability": {
          "enum": [
            "optional-skill-required"
          ]
        },
        "task_mode": {
          "$ref": "#/$defs/taskModeName"
        },
        "mutation_permission": {
          "$ref": "#/$defs/mutationPermission"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "profile_availability": {
          "enum": [
            "fallback-profile",
            "optional-skill-required",
            "explicit-profile-required"
          ]
        },
        "required_evidence": {
          "$ref": "#/$defs/stringArray"
        },
        "negated_intents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/negatedIntent"
          },
          "uniqueItems": true
        }
      },
      "dependentRequired": {
        "task_mode": [
          "mutation_permission"
        ],
        "mutation_permission": [
          "task_mode"
        ]
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "task_mode"
                ]
              },
              {
                "required": [
                  "mutation_permission"
                ]
              }
            ]
          },
          "then": {
            "$ref": "#/$defs/taskModePermissionPair"
          }
        }
      ],
      "additionalProperties": false
    },
    "taskModeName": {
      "enum": [
        "needs-triage",
        "readonly",
        "implementation",
        "debugging",
        "review",
        "release"
      ]
    },
    "mutationPermission": {
      "enum": [
        "deny",
        "workspace-write",
        "explicit-authorization-required"
      ]
    },
    "taskModePermissionPair": {
      "oneOf": [
        {
          "properties": {
            "task_mode": {
              "const": "needs-triage"
            },
            "mutation_permission": {
              "const": "deny"
            }
          },
          "required": [
            "task_mode",
            "mutation_permission"
          ]
        },
        {
          "properties": {
            "task_mode": {
              "const": "readonly"
            },
            "mutation_permission": {
              "const": "deny"
            }
          },
          "required": [
            "task_mode",
            "mutation_permission"
          ]
        },
        {
          "properties": {
            "task_mode": {
              "const": "implementation"
            },
            "mutation_permission": {
              "const": "workspace-write"
            }
          },
          "required": [
            "task_mode",
            "mutation_permission"
          ]
        },
        {
          "properties": {
            "task_mode": {
              "const": "debugging"
            },
            "mutation_permission": {
              "const": "deny"
            }
          },
          "required": [
            "task_mode",
            "mutation_permission"
          ]
        },
        {
          "properties": {
            "task_mode": {
              "const": "review"
            },
            "mutation_permission": {
              "const": "deny"
            }
          },
          "required": [
            "task_mode",
            "mutation_permission"
          ]
        },
        {
          "properties": {
            "task_mode": {
              "const": "release"
            },
            "mutation_permission": {
              "const": "explicit-authorization-required"
            }
          },
          "required": [
            "task_mode",
            "mutation_permission"
          ]
        }
      ]
    },
    "routingDefaults": {
      "type": "object",
      "required": [
        "task_mode",
        "mutation_permission",
        "risk",
        "profile_availability",
        "required_evidence"
      ],
      "properties": {
        "task_mode": {
          "const": "needs-triage"
        },
        "mutation_permission": {
          "const": "deny"
        },
        "risk": {
          "const": "unknown"
        },
        "profile_availability": {
          "const": "fallback-profile"
        },
        "required_evidence": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "taskMode": {
      "type": "object",
      "required": [
        "task_mode",
        "intent_zh",
        "priority",
        "mutation_permission"
      ],
      "properties": {
        "task_mode": {
          "$ref": "#/$defs/taskModeName"
        },
        "intent_zh": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "mutation_permission": {
          "$ref": "#/$defs/mutationPermission"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/taskModePermissionPair"
        }
      ],
      "additionalProperties": false
    },
    "artifactModeMapping": {
      "type": "object",
      "required": [
        "needs-triage",
        "readonly",
        "implementation",
        "debugging",
        "review",
        "release"
      ],
      "properties": {
        "needs-triage": {
          "type": "null"
        },
        "readonly": {
          "const": "readonly"
        },
        "implementation": {
          "const": "implementation"
        },
        "debugging": {
          "const": "readonly"
        },
        "review": {
          "const": "readonly"
        },
        "release": {
          "const": "release"
        }
      },
      "additionalProperties": false
    },
    "negatedIntent": {
      "type": "object",
      "required": [
        "name",
        "all_of"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/negatedIntentCondition"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "negatedIntentCondition": {
      "type": "object",
      "required": [
        "phrase_class",
        "polarity"
      ],
      "properties": {
        "phrase_class": {
          "enum": [
            "readonly_scope",
            "generic_execution",
            "planning_action",
            "debugging_action",
            "release_action"
          ]
        },
        "polarity": {
          "enum": [
            "positive",
            "negated"
          ]
        }
      },
      "additionalProperties": false
    },
    "routingPhraseClasses": {
      "type": "object",
      "required": [
        "readonly_scope",
        "generic_execution",
        "planning_action",
        "debugging_action",
        "release_action"
      ],
      "properties": {
        "readonly_scope": {
          "$ref": "#/$defs/stringArray"
        },
        "generic_execution": {
          "$ref": "#/$defs/stringArray"
        },
        "planning_action": {
          "$ref": "#/$defs/stringArray"
        },
        "debugging_action": {
          "$ref": "#/$defs/stringArray"
        },
        "release_action": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "negationPhraseClasses": {
      "type": "object",
      "required": [
        "direct_prohibition",
        "not_required",
        "execution_denial",
        "contrastive_prohibition",
        "generic_negation"
      ],
      "properties": {
        "direct_prohibition": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "contains": {
                "const": "别"
              }
            },
            {
              "contains": {
                "const": "不要"
              }
            },
            {
              "contains": {
                "const": "请勿"
              }
            }
          ]
        },
        "not_required": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "contains": {
                "const": "不需要"
              }
            },
            {
              "contains": {
                "const": "无需"
              }
            }
          ]
        },
        "execution_denial": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "contains": {
                "const": "不执行"
              }
            },
            {
              "contains": {
                "const": "不做"
              }
            }
          ]
        },
        "contrastive_prohibition": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "const": "不过别"
          }
        },
        "generic_negation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "const": "不"
          }
        }
      },
      "additionalProperties": false
    },
    "routingAbstain": {
      "type": "object",
      "required": [
        "enabled",
        "decision",
        "reason",
        "mutation_permission"
