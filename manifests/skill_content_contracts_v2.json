    "capability_class_by_pattern": {
      "tool-wrapper": "tool",
      "generator": "task",
      "reviewer": "task",
      "inversion": "support",
      "pipeline": "workflow",
      "playbook": "task",
      "governance": "guardrail"
    },
    "effect_ceiling_by_category": {
      "routing": "read-only",
      "intake": "read-only",
      "planning": "read-only",
      "design": "read-only",
      "implementation": "workspace-write",
      "debugging": "diagnostic-execution",
      "verification": "diagnostic-execution",
      "review_quality": "read-only",
      "release_closure": "release-preparation",
      "governance": "read-only"
    },
