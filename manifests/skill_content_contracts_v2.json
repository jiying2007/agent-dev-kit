    "effect_operation_by_ceiling": {
      "read-only": "read",
      "diagnostic-execution": "diagnostic",
      "workspace-write": "write",
      "build-artifact-write": "write",
      "release-preparation": "prepare",
      "external-read": "read"
    },
    "runtime_role_resolution": "override-else-support-knowledge-supporting-guardrail-governance-else-manifest-activation",
    "selection_group_resolution": "override-else-manifest-category",
    "implicit_trigger_policy_resolution": "override-else-primary-eligible-supporting-promote-same-group-else-explicit-only",
    "eval_obligations": {
      "trigger": true,
      "behavior": true,
      "authority_for": ["workflow", "guardrail", "tool", "meta"]
    }
  },
