{
  "schema_version": "1.0.0",
  "last_updated": "2026-07-14",
  "scope_model": "platform-neutral-adk-runtime",
  "source_docs": [
    "openai-codex-config-reference",
    "openai-codex-requirements-toml",
    "openai-codex-sandbox-defaults",
    "openai-codex-agent-approvals-security-dangerous-settings",
    "openai-codex-permissions",
    "openai-codex-memories",
    "openai-codex-best-practices"
  ],
  "external_source_refs": [
    "owasp-agentic-top10-2026"
  ],
  "reference_boundary": "OpenAI product docs are used only as official reference material. This manifest defines platform-neutral ADK runtime policy and does not include compatibility bindings.",
  "policy_layers": [
    {
      "id": "managed-runtime-requirements",
      "owner": "agent-dev-kit",
      "config_file": "managed runtime requirements",
      "precedence": "administrator-or-team-enforced",
      "user_override_allowed": false,
      "required_controls": [
        "allowed_approval_policies",
        "allowed_sandbox_modes",
        "allowed_live_search_modes",
        "tool_server.identity",
        "permissions.filesystem.deny_read",
        "command_rules.prefix_rules"
      ],
      "managed_hooks_policy": "Managed hooks may disable user, project, session and plugin hooks while preserving team-enforced hooks.",
      "network_policy": {
        "deny_wins": true,
        "global_allow_allowed": false,
        "managed_allowed_domains_only_preferred": true,
        "network_proxy_required_when_network_enabled": true,
        "allow_local_binding_default": false,
        "dangerously_allow_non_loopback_proxy_default": false,
        "dangerously_allow_all_unix_sockets_default": false,
        "unix_sockets_allowlist_required": true
      },
      "web_search_policy": {
        "allowed_modes": [
          "disabled",
          "cached"
        ],
        "live_requires_explicit_approval": true,
        "treat_results_as_untrusted": true,
        "full_access_live_default_must_be_overridden": true
      },
      "verification": [
        "runtime config evidence when available",
        "check-official-docs-governance",
        "runtime-boundary"
      ]
    },
    {
      "id": "project-runtime-boundary",
      "owner": "agent-dev-kit",
      "config_file": "project-local agent runtime config",
      "precedence": "project-scoped-when-trusted",
      "user_override_allowed": true,
      "must_not_override": [
        "provider_base_url",
        "auth_provider",
        "openai_base_url",
        "chatgpt_base_url",
        "apps_mcp_product_sku",
        "model_provider",
        "model_providers",
        "notifications",
        "notify",
        "profile",
        "profiles",
        "experimental_realtime_ws_base_url",
        "otel",
        "telemetry"
      ],
      "required_controls": [
        "approval_policy",
        "sandbox_mode",
        "workspace_write.writable_roots",
        "tool_servers.<id>.enabled_tools",
        "tool_servers.<id>.disabled_tools",
        "tool_servers.<id>.tools.<tool>.approval_mode"
      ],
      "verification": [
        "runtime config evidence when available",
        "check-official-docs-governance"
      ]
    }
  ],
  "config_key_boundaries": {
    "project_local_must_not_override": [
      "openai_base_url",
      "chatgpt_base_url",
      "apps_mcp_product_sku",
      "model_provider",
      "model_providers",
      "notify",
      "profile",
      "profiles",
      "experimental_realtime_ws_base_url",
      "otel"
    ],
    "user_level_only": [
      "provider",
      "auth",
      "host_owned_app_request_metadata",
      "configuration_profile_selection",
      "telemetry_routing"
    ],
    "project_local_allowed_when_trusted": [
      "approval_policy",
      "sandbox_mode",
      "sandbox_workspace_write.*",
      "skills.config",
      "hooks",
      "mcp_servers.<id>.enabled_tools",
      "mcp_servers.<id>.disabled_tools"
    ],
    "verification": [
      "compare project-local config against deny list",
      "record trust_level before applying project-scoped config",
      "check-official-docs-governance"
    ]
  },
  "granular_approval_policy": {
    "allowed_keys": [
      "sandbox_approval",
      "rules",
      "mcp_elicitations",
      "request_permissions",
      "skill_approval"
    ],
    "default_reviewer": "user",
    "auto_review_requires_policy": true,
    "must_record": [
      "approval_policy",
      "approvals_reviewer",
      "auto_review.policy",
      "denial_retry_path",
      "sandbox_boundary_unchanged"
    ],
    "must_not": [
      "treat auto_review as human approval",
      "use granular approval to bypass sandbox",
      "auto-approve destructive or open-world tools without review evidence"
    ]
  },
  "permission_profile_policy": {
    "built_in_profiles": [
      ":read-only",
      ":workspace",
      ":danger-full-access"
    ],
    "custom_profile_required_fields": [
      "description",
      "extends",
      "filesystem",
      "network",
      "workspace_roots"
    ],
    "deny_read_controls": [
      "deny exact paths",
      "workspace-root relative globs",
      "secret and credential paths"
    ],
    "network_controls": [
      "domains allow/deny with deny-wins",
      "unix_sockets allowlist",
      "allow_local_binding default false",
      "dangerously_allow_all_unix_sockets default false"
    ],
    "lint_rules": [
      "do not combine default_permissions with sandbox_mode or sandbox_workspace_write",
      "deny-read rules required for secret and credential paths",
      "unbounded deny-read globs require glob_scan_max_depth",
      "domain deny rules win over allow rules",
      "global network wildcard allow requires explicit risk record",
      "unix_sockets access requires explicit allowlist",
      "dangerously_allow_non_loopback_proxy and dangerously_allow_all_unix_sockets are forbidden defaults"
    ],
    "profile_templates": [
      {
        "id": "readonly-net",
        "default_permissions": "readonly-net",
        "filesystem": {
          ":minimal": "read",
          ":workspace_roots": {
            ".": "read",
            "**/*.env": "deny"
          },
          "glob_scan_max_depth": 3
        },
        "network": {
          "enabled": true,
          "domains": {
            "api.openai.com": "allow"
          }
        },
        "intended_use": "Read-only research or documentation checks with a narrow network allowlist."
      },
      {
        "id": "project-edit",
        "default_permissions": "project-edit",
        "extends": ":workspace",
        "filesystem": {
          ":workspace_roots": {
            ".": "write",
            ".devcontainer": "read",
            "**/*.env": "deny"
          },
          "glob_scan_max_depth": 3
        },
        "network": {
          "enabled": false
        },
        "intended_use": "Local implementation work inside assigned workspace roots without outbound network."
      }
    ],
    "must_not": [
      "extend :danger-full-access",
      "define cycles or undefined parent profiles",
      "grant broad network access without domain or socket allowlist"
    ]
  },
  "memory_runtime_policy": {
    "feature_flag": "features.memories",
    "default_enabled": false,
    "required_fields": [
      "memories.generate_memories",
      "memories.use_memories",
      "memories.disable_on_external_context",
      "memories.max_rollout_age_days",
      "memories.max_rollouts_per_startup",
      "memories.min_rollout_idle_hours",
      "memories.min_rate_limit_remaining_percent"
    ],
    "external_context_controls": [
      "MCP",
      "web_search",
      "tool_search"
    ],
    "quality_gates": [
      "threads with external context require source URL or tool evidence before memory candidate promotion",
      "external-context memories require redaction status and owner approval",
      "raw tool output must not be stored as durable memory",
      "rate-limit and idle-hour thresholds must be recorded for automated memory generation"
    ],
    "must_not": [
      "enable memories by default for every profile",
      "promote MCP, web search or tool search output without raw fallback",
      "copy raw session transcripts into long-term memory"
    ]
  },
  "agentic_security_taxonomy": {
    "id": "owasp-agentic-top10-2026-crosswalk-v1",
    "source_refs": [
      "owasp-agentic-top10-2026"
    ],
    "required_fields": [
      "threat_id",
      "threat_name",
      "local_surfaces",
      "preventive_controls",
      "evidence_required",
      "residual_risk"
    ],
    "coverage_policy": "ASI01-ASI10 are a coverage taxonomy; each category must map to local controls and evidence, but taxonomy presence alone is not a security certification.",
    "threats": [
      {
        "id": "ASI01",
        "name": "Agent Goal Hijack",
        "local_surfaces": [
          "external source ingestion",
          "tool and skill routing",
          "browser and MCP content"
        ],
        "preventive_controls": [
          "treat external content as untrusted data",
          "preserve instruction and goal precedence",
          "require approval for consequential scope changes"
        ],
        "evidence_required": [
          "source provenance",
          "instruction-boundary decision",
          "negative goal-hijack fixture"
        ],
        "residual_risk": "model interpretation can still be influenced by novel indirect instructions"
      },
      {
        "id": "ASI02",
        "name": "Tool Misuse and Exploitation",
        "local_surfaces": [
          "tool selection",
          "write-capable commands",
          "automation executors"
        ],
        "preventive_controls": [
          "least-capability tool exposure",
          "schema and policy validation before execution",
          "bounded approvals and rollback"
        ],
        "evidence_required": [
          "tool allowlist",
          "side-effect classification",
          "misuse rejection fixture"
        ],
        "residual_risk": "valid tools may still compose into an unsafe multi-step action"
      },
      {
        "id": "ASI03",
        "name": "Identity and Privilege Abuse",
        "local_surfaces": [
          "credentials",
          "approval identities",
          "MCP and connector auth"
        ],
        "preventive_controls": [
          "credential source isolation",
          "least privilege and deny paths",
          "human approval cannot be inferred from agent output"
        ],
        "evidence_required": [
          "auth boundary",
          "permission profile",
          "approval audit record"
        ],
        "residual_risk": "provider-side identity and token lifecycle remain outside ADK control"
      },
      {
        "id": "ASI04",
        "name": "Agentic Supply Chain Vulnerabilities",
        "local_surfaces": [
          "skills",
          "plugins",
          "MCP dependencies",
          "external scripts"
        ],
        "preventive_controls": [
          "version and artifact digest pinning",
          "license and provenance review",
          "method-only default before runtime promotion"
        ],
        "evidence_required": [
          "source URL and revision",
          "namespace verification",
          "supply-chain review and rollback"
        ],
        "residual_risk": "trusted namespace ownership does not prove artifact integrity or maintainer intent"
      },
      {
        "id": "ASI05",
        "name": "Unexpected Code Execution",
        "local_surfaces": [
          "shell commands",
          "generated code",
          "hooks and tool servers"
        ],
        "preventive_controls": [
          "sandbox and workspace boundaries",
          "command approval and deny rules",
          "disable hooks and unknown runtimes by default"
        ],
        "evidence_required": [
          "sandbox profile",
          "command transcript",
          "unexpected-execution negative fixture"
        ],
        "residual_risk": "sandbox or runtime vulnerabilities may bypass policy controls"
      },
      {
        "id": "ASI06",
        "name": "Memory and Context Poisoning",
        "local_surfaces": [
          "memories",
          "context summaries",
          "knowledge archives"
        ],
        "preventive_controls": [
          "memory disabled by default",
          "source attribution and raw fallback",
          "redaction and owner review before promotion"
        ],
        "evidence_required": [
          "memory candidate provenance",
          "redaction status",
          "poisoned-context rejection fixture"
        ],
        "residual_risk": "previously approved summaries can become stale or misleading"
      },
      {
        "id": "ASI07",
        "name": "Insecure Inter-Agent Communication",
        "local_surfaces": [
          "subagent handoffs",
          "MCP messages",
          "future ACP and A2A transports"
        ],
        "preventive_controls": [
          "explicit sender, scope and output contract",
          "schema validation and trust boundary",
          "ACP and A2A remain watch-only without security review"
        ],
        "evidence_required": [
          "handoff contract",
          "message provenance",
          "protocol compatibility and auth review"
        ],
        "residual_risk": "cross-runtime identity and message authenticity are not provided by ADK assets alone"
      },
      {
        "id": "ASI08",
        "name": "Cascading Failures",
        "local_surfaces": [
          "multi-step workflows",
          "automations",
          "parallel agent orchestration"
        ],
        "preventive_controls": [
          "bounded retries and stop conditions",
          "operation caps and kill switch",
          "checkpointed verification before downstream actions"
        ],
        "evidence_required": [
          "retry budget",
          "checkpoint state",
          "cascade containment fixture"
        ],
        "residual_risk": "externally triggered side effects may not be reversible"
      },
      {
        "id": "ASI09",
        "name": "Human-Agent Trust Exploitation",
        "local_surfaces": [
          "approval prompts",
          "completion claims",
          "review artifacts"
        ],
        "preventive_controls": [
          "evidence-backed claims",
          "explicit uncertainty and residual risk",
          "structured payload review for write actions"
        ],
        "evidence_required": [
          "claim-to-evidence index",
          "independent verifier result",
          "misleading-approval negative fixture"
        ],
        "residual_risk": "polished output can still create unjustified operator confidence"
      },
      {
        "id": "ASI10",
        "name": "Rogue Agents",
        "local_surfaces": [
          "long-running tasks",
          "automations",
          "delegated agents"
        ],
        "preventive_controls": [
          "least privilege and disabled-by-default automation",
          "heartbeat, stop condition and kill switch",
          "scope drift detection and owner escalation"
        ],
        "evidence_required": [
          "declared goal and scope",
          "timeline and kill-switch audit",
          "scope-drift rejection fixture"
        ],
        "residual_risk": "behavioral drift may emerge without an observable policy violation"
      }
    ],
    "quality_gates": [
      "all ASI01-ASI10 identifiers are present exactly once",
      "each threat maps to at least one preventive control and one evidence item",
      "security claims distinguish static coverage from runtime effectiveness"
    ],
    "must_not": [
      "claim OWASP certification from taxonomy coverage",
      "copy external mitigation prose into runtime prompts",
      "treat a static crosswalk as evidence that runtime attacks are prevented"
    ]
  },
  "sandbox_presets": [
    {
      "id": "low-risk-local-automation",
      "sandbox_mode": "workspace-write",
      "approval_policy": "on-request",
      "approvals_reviewer": "user",
      "risk": "low",
      "default_allowed": true,
      "required_evidence": [
        "writable roots",
        "approval policy",
        "command prefix exceptions"
      ]
    },
    {
      "id": "auto-reviewed-local-automation",
      "sandbox_mode": "workspace-write",
      "approval_policy": "on-request",
      "approvals_reviewer": "auto_review",
      "risk": "medium",
      "default_allowed": false,
      "required_evidence": [
        "auto-review policy",
        "denial retry path",
        "sandbox boundary unchanged"
      ]
    },
    {
      "id": "full-access",
      "sandbox_mode": "danger-full-access",
      "approval_policy": "never",
      "approvals_reviewer": "none",
      "risk": "critical",
      "default_allowed": false,
      "required_evidence": [
        "explicit user approval",
        "rollback path",
        "bounded target",
        "postcondition check"
      ]
    }
  ],
  "forbidden_defaults": [
    {
      "id": "danger-full-access-never",
      "sandbox_mode": "danger-full-access",
      "approval_policy": "never",
      "reason": "Equivalent to full access and must not be a default ADK runtime preset."
    },
    {
      "id": "network-global-allow",
      "pattern": "network.domains.* = allow",
      "reason": "Global network allow broadly opens outbound access; use scoped domains and deny-wins policy."
    },
    {
      "id": "network-proxy-non-loopback",
      "pattern": "network_proxy.dangerously_allow_non_loopback_proxy = true",
      "reason": "Non-loopback proxy listeners widen local trust boundaries and require explicit approval plus remote exposure review."
    },
    {
      "id": "all-unix-sockets",
      "pattern": "network_proxy.dangerously_allow_all_unix_sockets = true",
      "reason": "Bypassing the Unix socket allowlist can expose local daemons; use explicit socket allow rules instead."
    },
    {
      "id": "web-search-live-default",
      "pattern": "web_search = live",
      "reason": "Live web search exposes the agent to fresh untrusted content and prompt injection; cached or disabled is the safe default."
    }
  ]
}
