{
  "schema_version": "1.0.0",
  "last_updated": "2026-06-15",
  "scope_model": "platform-neutral-adk-runtime",
  "source_docs": [
    "openai-codex-config-reference",
    "openai-codex-requirements-toml",
    "openai-codex-sandbox-defaults",
    "openai-codex-agent-approvals-security-dangerous-settings",
    "openai-codex-permissions",
    "openai-codex-memories",
    "openai-codex-best-practices"
  ],
  "reference_boundary": "OpenAI product docs are used only as official reference material. This manifest defines platform-neutral ADK runtime policy and does not include compatibility bindings.",
  "policy_layers": [
    {
      "id": "managed-runtime-requirements",
      "owner": "agent-dev-kit",
      "config_file": "managed runtime requirements",
      "precedence": "administrator-or-team-enforced",
      "user_override_allowed": false,
      "required_controls": [
        "allowed_approval_policies",
        "allowed_sandbox_modes",
        "allowed_live_search_modes",
        "tool_server.identity",
        "permissions.filesystem.deny_read",
        "command_rules.prefix_rules"
      ],
      "managed_hooks_policy": "Managed hooks may disable user, project, session and plugin hooks while preserving team-enforced hooks.",
      "network_policy": {
        "deny_wins": true,
        "global_allow_allowed": false,
        "managed_allowed_domains_only_preferred": true,
        "network_proxy_required_when_network_enabled": true,
        "allow_local_binding_default": false,
        "dangerously_allow_non_loopback_proxy_default": false,
        "dangerously_allow_all_unix_sockets_default": false,
        "unix_sockets_allowlist_required": true
      },
      "web_search_policy": {
        "allowed_modes": [
          "disabled",
          "cached"
        ],
        "live_requires_explicit_approval": true,
        "treat_results_as_untrusted": true,
        "full_access_live_default_must_be_overridden": true
      },
      "verification": [
        "runtime config evidence when available",
        "check-official-docs-governance",
        "runtime-boundary"
      ]
    },
    {
      "id": "project-runtime-boundary",
      "owner": "agent-dev-kit",
      "config_file": "project-local agent runtime config",
      "precedence": "project-scoped-when-trusted",
      "user_override_allowed": true,
      "must_not_override": [
        "provider_base_url",
        "auth_provider",
        "openai_base_url",
        "chatgpt_base_url",
        "apps_mcp_product_sku",
        "model_provider",
        "model_providers",
        "notifications",
        "notify",
        "profile",
        "profiles",
        "experimental_realtime_ws_base_url",
        "otel",
        "telemetry"
      ],
      "required_controls": [
        "approval_policy",
        "sandbox_mode",
        "workspace_write.writable_roots",
        "tool_servers.<id>.enabled_tools",
        "tool_servers.<id>.disabled_tools",
        "tool_servers.<id>.tools.<tool>.approval_mode"
      ],
      "verification": [
        "runtime config evidence when available",
        "check-official-docs-governance"
      ]
    }
  ],
  "config_key_boundaries": {
    "project_local_must_not_override": [
      "openai_base_url",
      "chatgpt_base_url",
      "apps_mcp_product_sku",
      "model_provider",
      "model_providers",
      "notify",
      "profile",
      "profiles",
      "experimental_realtime_ws_base_url",
      "otel"
    ],
    "user_level_only": [
      "provider",
      "auth",
      "host_owned_app_request_metadata",
      "configuration_profile_selection",
      "telemetry_routing"
    ],
    "project_local_allowed_when_trusted": [
      "approval_policy",
      "sandbox_mode",
      "sandbox_workspace_write.*",
      "skills.config",
      "hooks",
      "mcp_servers.<id>.enabled_tools",
      "mcp_servers.<id>.disabled_tools"
    ],
    "verification": [
      "compare project-local config against deny list",
      "record trust_level before applying project-scoped config",
      "check-official-docs-governance"
    ]
  },
  "granular_approval_policy": {
    "allowed_keys": [
      "sandbox_approval",
      "rules",
      "mcp_elicitations",
      "request_permissions",
      "skill_approval"
    ],
    "default_reviewer": "user",
    "auto_review_requires_policy": true,
    "must_record": [
      "approval_policy",
      "approvals_reviewer",
      "auto_review.policy",
      "denial_retry_path",
      "sandbox_boundary_unchanged"
    ],
    "must_not": [
      "treat auto_review as human approval",
      "use granular approval to bypass sandbox",
      "auto-approve destructive or open-world tools without review evidence"
    ]
  },
  "permission_profile_policy": {
    "built_in_profiles": [
      ":read-only",
      ":workspace",
      ":danger-full-access"
    ],
    "custom_profile_required_fields": [
      "description",
      "extends",
      "filesystem",
      "network",
      "workspace_roots"
    ],
    "deny_read_controls": [
      "deny exact paths",
      "workspace-root relative globs",
      "secret and credential paths"
    ],
    "network_controls": [
      "domains allow/deny with deny-wins",
      "unix_sockets allowlist",
      "allow_local_binding default false",
      "dangerously_allow_all_unix_sockets default false"
    ],
    "lint_rules": [
      "do not combine default_permissions with sandbox_mode or sandbox_workspace_write",
      "deny-read rules required for secret and credential paths",
      "unbounded deny-read globs require glob_scan_max_depth",
      "domain deny rules win over allow rules",
      "global network wildcard allow requires explicit risk record",
      "unix_sockets access requires explicit allowlist",
      "dangerously_allow_non_loopback_proxy and dangerously_allow_all_unix_sockets are forbidden defaults"
    ],
    "profile_templates": [
      {
        "id": "readonly-net",
        "default_permissions": "readonly-net",
        "filesystem": {
          ":minimal": "read",
          ":workspace_roots": {
            ".": "read",
            "**/*.env": "deny"
          },
          "glob_scan_max_depth": 3
        },
        "network": {
          "enabled": true,
          "domains": {
            "api.openai.com": "allow"
          }
        },
        "intended_use": "Read-only research or documentation checks with a narrow network allowlist."
      },
      {
        "id": "project-edit",
        "default_permissions": "project-edit",
        "extends": ":workspace",
        "filesystem": {
          ":workspace_roots": {
            ".": "write",
            ".devcontainer": "read",
            "**/*.env": "deny"
          },
          "glob_scan_max_depth": 3
        },
        "network": {
          "enabled": false
        },
        "intended_use": "Local implementation work inside assigned workspace roots without outbound network."
      }
    ],
    "must_not": [
      "extend :danger-full-access",
      "define cycles or undefined parent profiles",
      "grant broad network access without domain or socket allowlist"
    ]
  },
  "memory_runtime_policy": {
    "feature_flag": "features.memories",
    "default_enabled": false,
    "required_fields": [
      "memories.generate_memories",
      "memories.use_memories",
      "memories.disable_on_external_context",
      "memories.max_rollout_age_days",
      "memories.max_rollouts_per_startup",
      "memories.min_rollout_idle_hours",
      "memories.min_rate_limit_remaining_percent"
    ],
    "external_context_controls": [
      "MCP",
      "web_search",
      "tool_search"
    ],
    "quality_gates": [
      "threads with external context require source URL or tool evidence before memory candidate promotion",
      "external-context memories require redaction status and owner approval",
      "raw tool output must not be stored as durable memory",
      "rate-limit and idle-hour thresholds must be recorded for automated memory generation"
    ],
    "must_not": [
      "enable memories by default for every profile",
      "promote MCP, web search or tool search output without raw fallback",
      "copy raw session transcripts into long-term memory"
    ]
  },
  "sandbox_presets": [
    {
      "id": "low-risk-local-automation",
      "sandbox_mode": "workspace-write",
      "approval_policy": "on-request",
      "approvals_reviewer": "user",
      "risk": "low",
      "default_allowed": true,
      "required_evidence": [
        "writable roots",
        "approval policy",
        "command prefix exceptions"
      ]
    },
    {
      "id": "auto-reviewed-local-automation",
      "sandbox_mode": "workspace-write",
      "approval_policy": "on-request",
      "approvals_reviewer": "auto_review",
      "risk": "medium",
      "default_allowed": false,
      "required_evidence": [
        "auto-review policy",
        "denial retry path",
        "sandbox boundary unchanged"
      ]
    },
    {
      "id": "full-access",
      "sandbox_mode": "danger-full-access",
      "approval_policy": "never",
      "approvals_reviewer": "none",
      "risk": "critical",
      "default_allowed": false,
      "required_evidence": [
        "explicit user approval",
        "rollback path",
        "bounded target",
        "postcondition check"
      ]
    }
  ],
  "forbidden_defaults": [
    {
      "id": "danger-full-access-never",
      "sandbox_mode": "danger-full-access",
      "approval_policy": "never",
      "reason": "Equivalent to full access and must not be a default ADK runtime preset."
    },
    {
      "id": "network-global-allow",
      "pattern": "network.domains.* = allow",
      "reason": "Global network allow broadly opens outbound access; use scoped domains and deny-wins policy."
    },
    {
      "id": "network-proxy-non-loopback",
      "pattern": "network_proxy.dangerously_allow_non_loopback_proxy = true",
      "reason": "Non-loopback proxy listeners widen local trust boundaries and require explicit approval plus remote exposure review."
    },
    {
      "id": "all-unix-sockets",
      "pattern": "network_proxy.dangerously_allow_all_unix_sockets = true",
      "reason": "Bypassing the Unix socket allowlist can expose local daemons; use explicit socket allow rules instead."
    },
    {
      "id": "web-search-live-default",
      "pattern": "web_search = live",
      "reason": "Live web search exposes the agent to fresh untrusted content and prompt injection; cached or disabled is the safe default."
    }
  ]
}
