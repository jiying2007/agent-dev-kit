  "execution_policy": {
    "execution_enabled_default": false,
    "external_network_default": "deny",
    "credential_mode": "ephemeral-explicit-only",
    "raw_trace_storage": false,
    "owner_approval_required": true,
    "container_policy": "version-and-digest-pinned-after-license-and-security-review",
    "deny_paths_required": true
  },
  "process_quality": {
    "source_method": "AgentLens-process-quality-adaptation",
    "required_fields": [
      "regression_cycle_count",
      "blind_retry_count",
      "final_verification",
      "phase_order_violation",
      "repeated_tool_call_without_new_evidence"
    ],
    "pass_with_invalid_process": "fail-closed"
  },
  "resource_metrics": {
    "source_method": "token-cost-distribution-adaptation",
    "required_fields": [
      "input_tokens",
      "cached_input_tokens",
      "output_tokens",
      "total_tokens",
      "cost_usd",
      "elapsed_ms",
      "attempts",
      "tool_calls",
      "timeouts"
    ],
    "aggregate_fields": [
      "p50",
      "p95",
      "max",
      "coefficient_of_variation",
      "cost_per_success"
    ],
    "agent_self_estimate_is_evidence": false
  },
  "outcome_policy": {
    "functional_first": true,
    "security_oracle_after_functional_pass": true,
    "llm_judge_only_security_oracle_allowed": false,
    "verified_change_required": true
  },
  "thresholds": {
    "candidate_success_rate": 1.0,
    "minimum_success_delta": 0.1,
    "maximum_invalid_process_rate": 0.0,
    "maximum_cost_per_success_usd": 0.1,
    "maximum_token_p95_ratio": 1.25,
    "required_non_regression_trials": 3
  },
