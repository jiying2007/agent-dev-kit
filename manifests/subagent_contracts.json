{
  "schema_version": "1.0.0",
  "last_updated": "2026-07-05",
  "source_docs": [
    "openai-agents-sdk-starting-point",
    "openai-codex-config-reference",
    "openai-codex-subagents-runtime",
    "openai-codex-best-practices"
  ],
  "runtime_limits": {
    "max_threads_default": 6,
    "max_depth_default": 1,
    "job_max_runtime_seconds_fallback": 1800,
    "nested_subagents_default_allowed": false,
    "must_record": [
      "features.multi_agent",
      "agents.max_threads",
      "agents.max_depth",
      "agents.job_max_runtime_seconds",
      "agent_type",
      "scope_write",
      "stop_condition",
      "subagent_result.summary",
      "subagent_result.evidence_refs",
      "subagent_result.raw_output_retention_decision"
    ],
    "must_not": [
      "spawn nested subagents without explicit max_depth approval",
      "treat subagent completion as integrated completion",
      "allow subagents to write shared contracts unless they own the integration task",
      "return raw logs, full stack traces, command transcripts or exploratory notes to the parent unless they are explicitly retained as evidence artifacts"
    ]
  },
  "job_evidence_schema": {
    "required_fields": [
      "job_id",
      "item_id",
      "agent_type",
      "scope_read",
      "scope_write",
      "status",
      "summary",
      "evidence_refs",
      "result_json",
      "raw_output_policy",
      "verification_commands",
      "last_error",
      "parent_integration_decision"
    ],
    "status_values": [
      "pass",
      "needs-fix",
      "blocked",
      "error"
    ],
    "csv_batch_required_fields": [
      "csv_path",
      "id_column",
      "instruction",
      "output_schema",
      "output_csv_path",
      "max_concurrency",
      "max_runtime_seconds"
    ],
    "quality_gates": [
      "each worker reports exactly once",
      "parent verifies integration after worker completion",
      "max_concurrency must not exceed agents.max_threads",
      "nested subagents require explicit max_depth approval",
      "worker returns distilled summary and evidence references instead of raw intermediate output",
      "raw logs or transcripts are linked as artifacts only when retention decision is explicit"
    ]
  },
  "custom_agent_lint": {
    "required_fields": [
      "name",
      "description",
      "developer_instructions"
    ],
    "optional_runtime_fields": [
      "nickname_candidates",
      "model",
      "model_reasoning_effort",
      "sandbox_mode",
      "mcp_servers",
      "skills.config"
    ],
    "quality_gates": [
      "description must be narrow enough for routing",
      "write-capable agents must declare sandbox and scope_write",
      "docs or research agents default to read-only",
      "custom agent name is the source of truth",
      "delegated agents must keep noisy exploration out of the parent thread and return summary plus evidence references"
    ]
  },
  "contracts": [
    {
      "id": "default-worker-contract",
      "owner": "lead-agent",
      "runtime_identity": "adk-subagent",
      "primary_skill": "task-specific",
      "supporting_skills": [],
      "scope_read": [
        "explicit task files",
        "local tests",
        "referenced runbooks"
      ],
      "scope_write": [
        "assigned files only"
      ],
      "must_not_touch": [
        ".git",
        "unassigned shared contracts",
        "credentials",
        "runtime apply targets"
      ],
      "handoff_condition": "Return when assigned scope is implemented, blocked, or verification fails twice.",
      "reply_owner": "lead-agent",
      "stop_condition": "pass | replan | split | blocked | abort",
      "report_schema": [
        "summary",
        "changed_files",
        "evidence_refs",
        "verification_commands",
        "result",
        "raw_output_policy",
        "risks",
        "open_items"
      ],
      "conflict_policy": "Do not revert other workers or user changes; report overlap and stop before editing conflicting files."
    }
  ]
}
