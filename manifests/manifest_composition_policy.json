{
  "schema": "adk-manifest-composition-policy/v1",
  "canonical_source": "manifest.json",
  "runtime_consumer_mode": "canonical-json-only",
  "authoring_mode": "single-canonical-json",
  "digest_semantics": "canonical-output-json",
  "composition_generator": null,
  "reference_composer": {
    "module": "agent_dev_kit.contracts.manifest_composition",
    "partition_function": "partition_by_owner",
    "compose_function": "compose_owned_sections",
    "mode": "pure-in-memory-only",
    "file_io": false,
    "runtime_enabled": false,
    "extension_owner": "extension-governance"
  },
  "operational_check": {
    "command": "manifest composition-check",
    "mode": "read-only-gate",
    "writes": false,
    "runtime_enabled": false
  },
  "future_split_contract": {
    "mode": "deterministic-build-time-only",
    "canonical_output": "manifest.json",
    "runtime_fragment_loading": false,
    "parallel_ssot_allowed": false,
    "generated_output_must_validate_before_consume": true,
    "generated_output_must_preserve_manifest_digest_semantics": true
  },
  "migration_gate": {
    "state": "blocked",
    "change_id": "manifest-build-time-split",
    "required_change_stage": "review-passed",
    "authoring_root": "manifests/manifest-sections",
    "generator_path": "tools/compose_manifest.py",
    "target_authoring_mode": "deterministic-build-time",
    "required_evidence": [
      "change-governance-pass",
      "executable-rollback-plan",
      "deterministic-double-generation",
      "strict-generated-output-validation",
      "canonical-digest-equivalence",
      "canonical-consumer-boundary-pass"
    ],
    "activation_invariants": {
      "canonical_output": "manifest.json",
      "runtime_fragment_loading": false,
      "parallel_ssot_allowed": false,
      "generated_output_must_validate_before_consume": true,
      "generated_output_must_preserve_manifest_digest_semantics": true
    }
  },
  "prohibited_runtime_composition_keys": [
    "$include",
    "include",
    "includes",
    "fragments",
    "imports"
  ],
  "section_owners": {
    "version": "identity",
    "locale": "identity",
    "platforms": "identity",
    "reference_sources": "reference-governance",
    "external_handoff_targets": "handoff-boundary",
    "tool_targets": "target-adapters",
    "quality_tiers": "quality-taxonomy",
    "asset_taxonomy": "quality-taxonomy",
    "knowledge_layers": "knowledge-context",
    "context_layers": "knowledge-context",
    "embedded_context_layers": "knowledge-context",
    "knowledge_types": "knowledge-context",
    "knowledge_maturity": "knowledge-context",
    "agents": "asset-catalog",
    "skills": "asset-catalog",
    "default_profile": "profile-resolution",
    "profiles": "profile-resolution",
    "workflows": "workflow-contracts",
    "mcp_servers": "target-adapters",
    "skill_invocation": "routing-policy",
    "change_sets": "workflow-contracts",
    "optional_skills": "asset-catalog",
    "install": "installation",
    "skill_routing_matrix": "routing-policy",
    "routing": "routing-policy",
    "dependencies": "dependency-governance",
    "schema_version": "identity",
    "product": "identity"
  }
}
