{
  "schema": "adk-target-contract/v2",
  "target": "claude-code",
  "status": "experimental",
  "source": {
    "urls": [
      "https://code.claude.com/docs/en/sub-agents",
      "https://code.claude.com/docs/en/skills"
    ],
    "retrieved_at": "2026-07-13",
    "review_status": "reviewed",
    "expires_at": "2026-10-11"
  },
  "supported_asset_kinds": ["agent", "skill"],
  "layouts": {
    "agent": "agents/{name}.md",
    "skill": "skills/{name}/SKILL.md"
  },
  "frontmatter": {
    "agent": {
      "required": ["name", "description", "tools"],
      "preserve": [],
      "static": {"permissionMode": "default"}
    },
    "skill": {
      "required": ["name", "description", "metadata"],
      "preserve": ["license", "compatibility"],
      "static": {}
    }
  },
  "skill_invocation": {
    "supported_modes": ["implicit", "explicit-only"],
    "explicit_only_frontmatter": {"disable-model-invocation": true}
  },
  "permission_profiles": {
    "read-only": {"tools": "Read, Grep, Glob"},
    "code-write": {"tools": "Read, Grep, Glob, Edit, Write, Bash"},
    "build-release": {"tools": "Read, Grep, Glob, Edit, Write, Bash"},
    "diagnostic": {"tools": "Read, Grep, Glob, Bash"}
  },
  "support_directories": ["references", "scripts", "assets", "templates", "examples"],
  "smoke_stages": ["discovery", "load", "trigger", "permission"],
  "adapter": {
    "adapter_id": "claude-code-direct-target",
    "runtime_boundary": "ADK renders and statically validates assets; Claude Code owns native discovery, load, trigger, permission, resume, cancel and trace behavior.",
    "capabilities": {
      "discovery": "declared-static",
      "load": "declared-static",
      "trigger": "declared-static",
      "permission": "declared-static",
      "resume": "unknown",
      "cancel": "unknown",
      "rollback": "declared-static",
      "trace": "unknown"
    },
    "conformance": {
      "level": "static",
      "certification": "not-certified",
      "native_runtime_smoke": "not-run",
      "runtime_binary": null,
      "runtime_binary_sha256": null,
      "runtime_version": null,
      "runtime_version_pin": null,
      "last_verified_at": null,
      "evidence": []
    },
    "conformance_trust_policy": {
      "enabled": false,
      "trusted_authorities": [],
      "verification_backend": "not-configured"
    },
    "failure_semantics": [
      "export success must not be treated as native runtime capability evidence",
      "native runtime failures preserve the static bundle and target-owned diagnostics",
      "ADK receipt rollback does not claim runtime session rollback"
    ],
    "trace_contract": "adk-workflow-trace-summary-v1"
  }
}
