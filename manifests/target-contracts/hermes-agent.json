{
  "schema": "adk-target-contract/v2",
  "target": "hermes-agent",
  "status": "experimental",
  "source": {
    "urls": [
      "https://hermes-agent.nousresearch.com/docs/user-guide/features/skills"
    ],
    "retrieved_at": "2026-07-13",
    "review_status": "reviewed",
    "expires_at": "2026-10-11"
  },
  "supported_asset_kinds": ["skill"],
  "layouts": {
    "skill": "skills/{name}/SKILL.md"
  },
  "frontmatter": {
    "skill": {
      "required": ["name", "description", "metadata"],
      "preserve": ["license", "compatibility"],
      "static": {}
    }
  },
  "skill_invocation": {
    "supported_modes": ["implicit"],
    "explicit_only_frontmatter": {}
  },
  "permission_profiles": {},
  "support_directories": ["references", "scripts", "assets", "templates", "examples"],
  "smoke_stages": ["discovery", "load", "trigger"],
  "adapter": {
    "adapter_id": "hermes-agent-direct-target",
    "runtime_boundary": "ADK renders and statically validates skill assets only; Hermes Agent owns all native runtime and session behavior.",
    "capabilities": {
      "discovery": "declared-static",
      "load": "declared-static",
      "trigger": "declared-static",
      "permission": "unsupported",
      "resume": "unknown",
      "cancel": "unknown",
      "rollback": "declared-static",
      "trace": "unknown"
    },
    "conformance": {
      "level": "static",
      "certification": "not-certified",
      "native_runtime_smoke": "not-run",
      "runtime_binary": null,
      "runtime_binary_sha256": null,
      "runtime_version": null,
      "runtime_version_pin": null,
      "last_verified_at": null,
      "evidence": []
    },
    "conformance_trust_policy": {
      "enabled": false,
      "trusted_authorities": [],
      "verification_backend": "not-configured"
    },
    "failure_semantics": [
      "agent asset selection fails before writing because Hermes Agent supports skill assets only",
      "skill export success must not be treated as native runtime capability evidence",
      "ADK receipt rollback does not claim runtime session rollback"
    ],
    "trace_contract": "adk-workflow-trace-summary-v1"
  }
}
