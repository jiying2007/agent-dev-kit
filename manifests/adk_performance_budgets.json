{
  "schema_version": "1.0.0",
  "last_updated": "2026-06-29",
  "scope_model": "report-first-performance-budgets",
    "boundary": "Performance budgets are local, report-only by default, and become blocking only when --strict is used with fresh timing evidence.",
    "platform_operations": {
        "manifest_validate": {
            "max_p95_ms": 200.0,
            "scope": "strict typed manifest validation without legacy shell gates"
        },
        "profile_resolve": {
            "max_p95_ms": 50.0,
            "scope": "embedded-fullstack profile inheritance and asset resolution"
        },
        "export_plan": {
            "max_p95_ms": 100.0,
            "scope": "Claude Code core export dry-run"
        }
    },
  "budgets": [
    {
      "budget_id": "quick-test-loop",
      "mode": "quick",
      "command": "tests/run_all.sh --quick --timing-json <path>",
      "max_elapsed_ms": 120000,
      "slow_threshold_sec": 10,
      "test": "tests/run_all.sh"
    },
    {
      "budget_id": "full-regression-loop",
      "mode": "full",
      "command": "tests/run_all.sh --timing-json <path>",
      "max_elapsed_ms": 600000,
      "slow_threshold_sec": 30,
      "test": "tests/run_all.sh"
    },
    {
      "budget_id": "performance-ops-smoke",
      "mode": "benchmark",
      "command": "scripts/performance.sh benchmark --summary-json",
      "max_elapsed_ms": 120000,
      "slow_threshold_sec": 10,
      "script": "scripts/performance.sh",
      "test": "tests/test_performance_ops.sh"
    }
  ]
}
