{
  "schema_version": "1.0.0",
  "last_updated": "2026-05-25",
  "source_docs": [
    "openai-apps-sdk-review-tool-hints"
  ],
  "reference_boundary": "OpenAI source docs are citation metadata and governance references only. This manifest promotes platform-neutral ADK slash-command audit contracts and must not enable runtime commands, write actions, user-directory writes, or compatibility defaults.",
  "audits": [
    {
      "command_id": "devkit-validate",
      "command": "scripts/devkit.sh validate --strict",
      "owner": "agent-dev-kit",
      "mode": "local-check",
      "read_only": true,
      "destructive": false,
      "open_world": false,
      "approval": "none",
      "evidence_required": "exit code and compact result summary"
    },
    {
      "command_id": "adk-apply-assets",
      "command": "scripts/install-assets.sh --plan <plan>",
      "owner": "agent-dev-kit",
      "mode": "report-only-until-approved",
      "read_only": false,
      "destructive": true,
      "open_world": false,
      "approval": "explicit-user-approval",
      "evidence_required": "dry-run plan, changed paths, rollback path, postcondition check"
    },
    {
      "command_id": "external-message-send",
      "command": "<connector>/send-message",
      "owner": "runtime-connector-owner",
      "mode": "report-only-until-approved",
      "read_only": false,
      "destructive": true,
      "open_world": true,
      "approval": "explicit-user-approval",
      "evidence_required": "recipient, payload preview, dry-run result, audit id, rollback/undo status"
    }
  ]
}
