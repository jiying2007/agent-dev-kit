{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-kit.local/schemas/target-contract-v2.json",
  "title": "agent-dev-kit direct target contract",
  "type": "object",
  "required": [
    "schema",
    "target",
    "status",
    "source",
    "supported_asset_kinds",
    "layouts",
    "frontmatter",
    "skill_invocation",
    "permission_profiles",
    "support_directories",
    "smoke_stages",
    "adapter"
  ],
  "properties": {
    "schema": {"const": "adk-target-contract/v2"},
    "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["experimental", "stable"]},
    "source": {
      "type": "object",
      "required": ["urls", "retrieved_at", "review_status", "expires_at"],
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://"}
        },
        "retrieved_at": {"type": "string", "format": "date"},
        "review_status": {"const": "reviewed"},
        "expires_at": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "supported_asset_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["agent", "skill"]}
    },
    "layouts": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "skill": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "frontmatter": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/frontmatterContract"}
    },
    "skill_invocation": {
      "type": "object",
      "required": ["supported_modes", "explicit_only_frontmatter"],
      "properties": {
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["implicit", "explicit-only"]}
        },
        "explicit_only_frontmatter": {"type": "object"}
      },
      "additionalProperties": false
    },
    "permission_profiles": {
      "type": "object",
      "propertyNames": {"enum": ["read-only", "code-write", "build-release", "diagnostic"]},
      "additionalProperties": {"type": "object"}
    },
    "support_directories": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["references", "scripts", "assets", "templates", "examples"]}
    },
    "smoke_stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["discovery", "load", "trigger", "permission"]}
    },
    "adapter": {
      "type": "object",
      "required": [
        "adapter_id",
        "runtime_boundary",
        "capabilities",
        "conformance",
        "conformance_trust_policy",
        "failure_semantics",
        "trace_contract"
      ],
      "properties": {
        "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "runtime_boundary": {"type": "string", "minLength": 1},
        "capabilities": {
          "type": "object",
          "required": ["discovery", "load", "trigger", "permission", "resume", "cancel", "rollback", "trace"],
          "propertyNames": {
            "enum": ["discovery", "load", "trigger", "permission", "resume", "cancel", "rollback", "trace"]
          },
          "additionalProperties": {"enum": ["declared-static", "native-verified", "unsupported", "unknown"]}
        },
        "conformance": {
          "oneOf": [
            {
              "type": "object",
              "required": ["level", "certification", "native_runtime_smoke", "runtime_binary", "runtime_binary_sha256", "runtime_version", "runtime_version_pin", "last_verified_at", "evidence"],
              "properties": {
                "level": {"const": "static"},
                "certification": {"const": "not-certified"},
                "native_runtime_smoke": {"const": "not-run"},
                "runtime_binary": {"type": "null"},
                "runtime_binary_sha256": {"type": "null"},
                "runtime_version": {"type": "null"},
                "runtime_version_pin": {"type": "null"},
                "last_verified_at": {"type": "null"},
                "evidence": {"type": "array", "maxItems": 0}
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["level", "certification", "native_runtime_smoke", "runtime_binary", "runtime_binary_sha256", "runtime_version", "runtime_version_pin", "last_verified_at", "evidence"],
              "properties": {
                "level": {"const": "runtime"},
                "certification": {"const": "conformance-certified"},
                "native_runtime_smoke": {"const": "pass"},
                "runtime_binary": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                "runtime_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "runtime_version": {"type": "string", "minLength": 1, "maxLength": 128},
                "runtime_version_pin": {"type": "string", "minLength": 1, "maxLength": 128},
                "last_verified_at": {"type": "string", "format": "date-time"},
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "required": ["receipt_schema", "path", "sha256", "target", "runtime_version", "bundle_sha256", "contract_sha256", "layer"],
                    "properties": {
                      "receipt_schema": {"const": "adk-native-target-conformance-receipt/v2"},
                      "path": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
                      },
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                      "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
                      "runtime_version": {"type": "string", "minLength": 1},
                      "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                      "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                      "layer": {"const": "runtime"}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "conformance_trust_policy": {
          "oneOf": [
            {
              "type": "object",
              "required": ["enabled", "trusted_authorities", "verification_backend"],
              "properties": {
                "enabled": {"const": false},
                "trusted_authorities": {"type": "array", "maxItems": 0},
                "verification_backend": {"const": "not-configured"}
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["enabled", "trusted_authorities", "verification_backend"],
              "properties": {
                "enabled": {"const": true},
                "trusted_authorities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
                },
                "verification_backend": {
                  "enum": ["external-signature-verifier", "ci-provenance-verifier"]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "failure_semantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "trace_contract": {"const": "adk-workflow-trace-summary-v2"}
      },
      "allOf": [
        {
          "if": {"properties": {"conformance": {"properties": {"level": {"const": "static"}}}}},
          "then": {
            "properties": {
              "conformance_trust_policy": {
                "properties": {"enabled": {"const": false}}
              },
              "capabilities": {
                "additionalProperties": {"enum": ["declared-static", "unsupported", "unknown"]}
              }
            }
          }
        },
        {
          "if": {"properties": {"conformance": {"properties": {"level": {"const": "runtime"}}}}},
          "then": {
            "properties": {
              "conformance_trust_policy": {
                "properties": {"enabled": {"const": true}}
              },
              "capabilities": {
                "properties": {
                  "discovery": {"const": "native-verified"},
                  "load": {"const": "native-verified"},
                  "trigger": {"const": "native-verified"}
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "frontmatterContract": {
      "type": "object",
      "required": ["required", "preserve", "static"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "preserve": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["license", "compatibility"]}
        },
        "static": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
