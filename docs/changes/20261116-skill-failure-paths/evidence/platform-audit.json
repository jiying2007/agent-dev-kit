  "decisions": [
    {
      "topic": "portable metadata and progressive disclosure",
      "decision": "KEEP",
      "rationale": "ADK targets._render_main projects standard name/description and namespaced provenance, target-specific fields stay in versioned target contracts. Existing source fields are internal, not copied indiscriminately. Baseline platform portable-skills reports pass across65 skills. This is static source/projection evidence, not native discovery/load/trigger."
    },
    {
      "topic": "client discovery/permissions/context retention",
      "decision": "NO_PLATFORM_IMPORT",
      "rationale": "agentskills client guide concerns runtime discovery, trust, activation, pruning and permissions. ADK is the asset/compiler control plane. Do not adopt lenient malformed-YAML acceptance, ambient client folder scans, or directory permission allowlisting as new authority."
    },
    {
      "topic": "versioned installed content integrity",
      "decision": "KEEP",
      "rationale": "Vercel pinned-commit/content-hash approach corroborates stable source vs installed-byte identities. ADK already separately binds source Git identity, canonical artifact digests and release/runtime evidence. Do not replace existing strict link policy or checksums with another install CLI/lock format."
    }
  ]
