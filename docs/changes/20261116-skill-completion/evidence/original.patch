a\": 5\n    },\n    \"content_portfolio_trigger\": {\n      \"tests\": 39,\n      \"passed\": 39\n    },\n    \"ctest_reader_scenarios\": 15,\n    \"default_timeout_actual_green\": true\n  },\n  \"limits\": [\n    \"Original five Ninja/multiconfig fixtures require CI execution; unavailable locally.\",\n    \"Native host fixtures do not qualify hardware or explain historical runner timeout root cause.\",\n    \"No independent review claimed by implementation owner.\"\n  ]\n}\n"
