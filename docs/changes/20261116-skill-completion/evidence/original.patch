+                else:
+                    self.assertEqual("Z", child_state)
+                self.assertIsNone(unrelated.poll(), "cleanup must not signal another process group")
+            finally:
+                unrelated.kill()
+                unrelated.wait(timeout=2)
+                if (root / "child.pid").exists():
+                    try:
