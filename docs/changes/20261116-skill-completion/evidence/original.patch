+      "content": "{\n  \"source_commit\": \"e13bd4788d5638c1eb34c169870f19dfd5285b6b\",\n  \"recorded_at\": \"2026-11-16T02:40:19.406138+00:00\",\n  \"files\": [\n    {\n      \"path\": \"skills/adk-parallel-agent-governance/SKILL.md\",\n      \"before_sha256\": \"79590645943c485b30a0807d08038918bc046d746bdf7d254efa224a81d7689b\",\n      \"after_sha256\": \"1336d4e8a3de6e7bf2f3aab4d09675f3ee794f7cb0476826076ffbebcf523b7c\",\n      \"before_bytes\": 4313,\n      \"after_bytes\": 4292,\n      \"delta_bytes\": -21\n    },\n    {\n      \"path\": \"skills/adk-parallel-agent-governance/references/parallel-worktree-task-package.md\",\n      \"before_sha256\": \"e1636ebb5af5a1c3f60f8d5711eb0d07b3ce52f9461d85dff4aa90017ad6afa7\",\n      \"after_sha256\": \"8b9ae9c13249cb1cc002e7bf090c1799fe83a2f625359ec4b79395dfaf56f3be\",\n      \"before_bytes\": 1708,\n      \"after_bytes\": 1716,\n      \"delta_bytes\": 8\n    },\n    {\n      \"path\": \"skills/adk-engineering-growth-review/SKILL.md\",\n      \"before_sha256\": \"1cb57aaa0364e19ccb07717a9c2e9586de56eb0dae98c8c7f0921cda5e9aac99\",\n      \"after_sha256\": \"0e3e8a5d3b55cbad4b32bdc113f3cace04ea36efeb20315033ceb8a6792991fd\",\n      \"before_bytes\": 3847,\n      \"after_bytes\": 3853,\n      \"delta_bytes\": 6\n    },\n    {\n      \"path\": \"skills/adk-engineering-growth-review/README.md\",\n      \"before_sha256\": \"9d19616439a76b780d6b66c41373a089b0c32406f1a073cf00c485925201f663\",\n      \"after_sha256\": \"ba06dc6db2436cac1e51707248013dc732ee228c074d8730c7ee5d7703981f63\",\n      \"before_bytes\": 741,\n      \"after_bytes\": 745,\n      \"delta_bytes\": 4\n    },\n    {\n      \"path\": \"skills/adk-archive-governance/SKILL.md\",\n      \"before_sha256\": \"ea121564230e9971ab16e53b048a80cdbbffb8e94347be6a932c62fac558dbd0\",\n      \"after_sha256\": \"a950a9e9916c4ec1377a4f56dbc55bb12e1c3198a89be677540d783544c62876\",\n      \"before_bytes\": 2543,\n      \"after_bytes\": 2687,\n      \"delta_bytes\": 144\n    },\n    {\n      \"path\": \"optional-skills/adk-data-fetch/SKILL.md\",\n      \"before_sha256\": \"2b21813be53528c13eefee6add282615730d36fa712073bae3943370e069b0f0\",\n      \"after_sha256\": \"93f99ba41694cd8bc4931d67a7fcbaf4f62540c17811b2db41a14062430ab011\",\n      \"before_bytes\": 3643,\n      \"after_bytes\": 4088,\n      \"delta_bytes\": 445\n    },\n    {\n      \"path\": \"skills/adk-code-review-loop/SKILL.md\",\n      \"before_sha256\": \"e47ea7c376430a10780a09d74ef689471228c220ae5660290f11a067d46f350d\",\n      \"after_sha256\": \"a941008e987ccb990250b4837634620660cc518b662e98c961557cce088e8e4f\",\n      \"before_bytes\": 6234,\n      \"after_bytes\": 6234,\n      \"delta_bytes\": 0\n    },\n    {\n      \"path\": \"skills/adk-code-review-loop/references/review-feedback-fixtures.md\",\n      \"before_sha256\": \"1020e8dd62dcb128827cf0ab89ece17dfef229abb6c05003b2b6c789b262e284\",\n      \"after_sha256\": \"731f4b0dd24c9c3baea0e7d76bbeef6eeeb746d23335cf96893c694b68e91fa4\",\n      \"before_bytes\": 2305,\n      \"after_bytes\": 2229,\n      \"delta_bytes\": -76\n    },\n    {\n      \"path\": \"tests/test_skill_content_contract.py\",\n      \"before_sha256\": \"822dcb61d0cbb8c1689247cc0a32f956e33cdc236f2504afff31ad7c6da462c7\",\n      \"after_sha256\": \"ab1726165e55c5b4ead3073608f5786b5367d7b520c87abe26836fe909a5dae8\",\n      \"before_bytes\": 21682,\n      \"after_bytes\": 30306,\n      \"delta_bytes\": 8624\n    }\n  ],\n  \"skill_entry_and_reference_delta\": 506,\n  \"notes\": \"Byte counts only, not Token or model improvement.\"\n}\n"
