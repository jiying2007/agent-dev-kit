-if (a) {
-    if (b) {
-        if (c) { do_something(); }
+// bool 来自 <stdbool.h>；do_something/cleanup 为既有操作。
+void process_before(bool a, bool b, bool c) {
+    if (a) {
+        if (b) {
+            if (c) { do_something(); }
+        }
     }
+    cleanup();
 }
 
-// After: 早期返回
-if (!a) return;
-if (!b) return;
-if (!c) return;
-do_something();
+void process_after(bool a, bool b, bool c) {
+    if (a && b && c) {
+        do_something();
+    }
+    cleanup();
+}
 ```
 
