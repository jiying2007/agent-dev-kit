+ROOT = Path(__file__).resolve().parents[1]
+PROFILE = ROOT / "skills/adk-performance-profiling-embedded/references/mcu-memory-footprint.md"
+FLAKY = ROOT / "optional-skills/adk-test-flakiness-triage/references/details.md"
