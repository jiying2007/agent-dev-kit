+def example(path: Path, language: str, marker: str) -> str:
+    matches = [code for code in re.findall(r"```" + language + r"\n(.*?)```", path.read_text(), re.S)
+               if marker in code]
+    if len(matches) != 1:
+        raise AssertionError(f"expected one published {marker} example")
+    return matches[0]
+
