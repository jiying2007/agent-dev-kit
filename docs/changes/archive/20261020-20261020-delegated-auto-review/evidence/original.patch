+def _archive_members(archive: tarfile.TarFile, target_name: str) -> List[tarfile.TarInfo]:
+    """Inspect the entire inventory before any selected target is moved."""
+    members: List[tarfile.TarInfo] = []
+    identities: Set[str] = set()
+    total = 0
