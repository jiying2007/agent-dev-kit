+            ["bash", str(ROOT / "scripts/devkit.sh"), "eval", *map(str, args)],
+            cwd=ROOT, env={**os.environ, "ADK_PYTHON_BIN": sys.executable},
+            capture_output=True, text=True, timeout=30,
+        )
+
